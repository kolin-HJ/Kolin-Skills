@@ -0,0 +1,12 @@
+const NIGHTLY_TIME_ZONE = "America/Denver";
+const NIGHTLY_LOCAL_HOUR = 4;
+
+const localHour = new Intl.DateTimeFormat("en-US", {
+  timeZone: NIGHTLY_TIME_ZONE,
+  hour: "numeric",
+  hourCycle: "h23",
+});
+
+export function isNightlyWindow(now: Date): boolean {
+  return Number(localHour.format(now)) === NIGHTLY_LOCAL_HOUR;
+}
