@@ -0,0 +1,41 @@
+import { NextResponse } from "next/server";
+
+import { requireCronAuth } from "@/lib/api-auth";
+import { syncItemFields } from "@/lib/demand-tools/item-fields";
+import { isNightlyWindow } from "@/lib/demand-tools/nightly-window";
+import { applyReprice } from "@/lib/demand-tools/reprice";
+import { alertJobFailure } from "@/lib/notify/gchat";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+export const maxDuration = 800;
+
+const ACTOR = "system:demand-tools-sync";
+
+type StepOutcome<T> = { ok: true; result: T } | { ok: false; error: string };
+
+async function runStep<T>(job: string, step: () => Promise<T>): Promise<StepOutcome<T>> {
+  try {
+    return { ok: true, result: await step() };
+  } catch (err) {
+    console.error(`[demand-tools-sync] ${job} failed`, err);
+    await alertJobFailure(job, "scheduled cron", err);
+    return { ok: false, error: err instanceof Error ? err.message : String(err) };
+  }
+}
+
+export async function GET(req: Request) {
+  const unauthorized = requireCronAuth(req);
+  if (unauthorized) return unauthorized;
+
+  if (!isNightlyWindow(new Date())) return NextResponse.json({ ok: true, skipped: true });
+
+  const t0 = Date.now();
+  const itemFields = await runStep("Demand tools item fields sync", () => syncItemFields(ACTOR));
+  const reprice = await runStep("Demand tools reprice to MSRP", () => applyReprice(ACTOR));
+  const ok = itemFields.ok && reprice.ok;
+  return NextResponse.json(
+    { ok, itemFields, reprice, elapsedMs: Date.now() - t0 },
+    { status: ok ? 200 : 500 }
+  );
+}
