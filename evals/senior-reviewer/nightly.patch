+import { describe, expect, it } from "vitest";
+
+import { isNightlyWindow } from "./nightly-window";
+
+describe("isNightlyWindow", () => {
+  it("opens at 10:00 UTC while Denver is on daylight time", () => {
+    expect(isNightlyWindow(new Date("2026-10-01T10:00:00Z"))).toBe(true);
+    expect(isNightlyWindow(new Date("2026-10-01T11:00:00Z"))).toBe(false);
+  });
+
+  it("opens at 11:00 UTC once Denver is on standard time", () => {
+    expect(isNightlyWindow(new Date("2026-12-01T11:00:00Z"))).toBe(true);
+    expect(isNightlyWindow(new Date("2026-12-01T10:00:00Z"))).toBe(false);
+  });
+
+  it("follows the clock change on the days it happens", () => {
+    expect(isNightlyWindow(new Date("2026-11-01T10:59:00Z"))).toBe(false);
+    expect(isNightlyWindow(new Date("2026-11-01T11:00:00Z"))).toBe(true);
+    expect(isNightlyWindow(new Date("2027-03-14T10:00:00Z"))).toBe(true);
+    expect(isNightlyWindow(new Date("2027-03-14T11:00:00Z"))).toBe(false);
+  });
+});
