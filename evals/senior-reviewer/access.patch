+"use client";
+
+import type { PageLevel } from "@/lib/permissions";
+
+const LABEL: Record<PageLevel, string> = { none: "None", read: "Read", write: "Read & write" };
+
+const ACTIVE: Record<PageLevel, string> = {
+  none: "bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-100",
+  read: "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300",
+  write: "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300",
+};
+
+export function LevelControl({
+  levels,
+  value,
+  onChange,
+  disabled,
+  label,
+}: {
+  levels: readonly PageLevel[];
+  value: PageLevel | "mixed";
+  onChange: (level: PageLevel) => void;
+  disabled?: boolean;
+  label: string;
+}) {
+  return (
+    <fieldset
+      aria-label={label}
+      className="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-[11px] font-medium"
+    >
+      {levels.map((level) => (
+        <button
+          key={level}
+          type="button"
+          disabled={disabled}
+          aria-pressed={value === level}
+          onClick={() => onChange(level)}
+          className={`px-2.5 py-1 border-l first:border-l-0 border-slate-200 dark:border-slate-700 transition-colors disabled:opacity-40 ${
+            value === level
+              ? ACTIVE[level]
+              : "text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800"
+          }`}
+        >
+          {LABEL[level]}
+        </button>
+      ))}
+    </fieldset>
+  );
+}
