+import type { AppUser } from "@/lib/auth";
+import { entryPath } from "@/lib/permissions";
+import { PAGES, type NavSection, TABS } from "@/lib/routes";
+
+export interface NavTab {
+  label: string;
+  section: NavSection;
+  href: string;
+}
+
+export const ALL_TABS: readonly NavTab[] = TABS.map((tab) => ({
+  label: tab.label,
+  section: tab.section,
+  href: PAGES[tab.home].path,
+}));
+
+export function tabsFor(user: Pick<AppUser, "role" | "capabilities"> | null): NavTab[] {
+  if (user === null) return [];
+  return ALL_TABS.flatMap((tab) => {
+    const href = entryPath(user, tab.section);
+    return href === null ? [] : [{ ...tab, href }];
+  });
+}
