+++ b/apps/web/src/app/(app)/settings/access/toast.tsx
@@ -0,0 +1,50 @@
+"use client";
+
+import { useEffectOnChange } from "@/lib/use-effect-on-change";
+
+export interface ToastState {
+  id: number;
+  text: string;
+  tone: "info" | "error";
+  undo?: (() => void) | undefined;
+}
+
+const LIFETIME_MS = 9000;
+
+export function Toast({ toast, onDismiss }: { toast: ToastState | null; onDismiss: () => void }) {
+  useEffectOnChange(toast, (current) => {
+    if (!current || current.tone === "error") return undefined;
+    const timer = setTimeout(onDismiss, LIFETIME_MS);
+    return () => clearTimeout(timer);
+  });
+
+  if (!toast) return null;
+  return (
+    <output
+      className={`fixed bottom-5 left-1/2 z-50 flex max-w-[min(92vw,640px)] -translate-x-1/2 items-center gap-3 rounded-lg px-4 py-2.5 text-sm shadow-lg ${
+        toast.tone === "error"
+          ? "bg-red-600 text-white"
+          : "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900"
+      }`}
+    >
+      <span className="min-w-0">{toast.text}</span>
+      {toast.undo && (
+        <button
+          type="button"
+          onClick={toast.undo}
+          className="shrink-0 rounded px-2 py-0.5 text-xs font-semibold underline underline-offset-2 hover:bg-white/15 dark:hover:bg-slate-900/10"
+        >
+          Undo
+        </button>
+      )}
+      <button
+        type="button"
+        aria-label="Dismiss"
+        onClick={onDismiss}
+        className="shrink-0 rounded px-1 text-base leading-none opacity-70 hover:opacity-100"
+      >
+        ×
+      </button>
+    </output>
+  );
+}
diff --git a/apps/web/src/app/(app)/settings/access/tri-checkbox.tsx b/apps/web/src/app/(app)/settings/access/tri-checkbox.tsx
new file mode 100644
index 00000000..e7178548
--- /dev/null
+++ b/apps/web/src/app/(app)/settings/access/tri-checkbox.tsx
@@ -0,0 +1,36 @@
+"use client";
+
+export type TriState = "all" | "some" | "none";
+
+export function triState(flags: readonly boolean[]): TriState {
+  if (flags.length > 0 && flags.every(Boolean)) return "all";
+  return flags.some(Boolean) ? "some" : "none";
+}
+
+export function TriCheckbox({
+  state,
+  onChange,
+  disabled,
+  children,
+}: {
+  state: TriState;
+  onChange: (granted: boolean) => void;
+  disabled?: boolean;
+  children: string;
+}) {
+  return (
+    <label className="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-300">
+      <input
+        ref={(el) => {
+          if (el) el.indeterminate = state === "some";
+        }}
+        type="checkbox"
+        disabled={disabled}
+        checked={state === "all"}
+        onChange={() => onChange(state !== "all")}
+        className="h-3.5 w-3.5 accent-blue-600"
+      />
+      {children}
+    </label>
+  );
+}
diff --git a/apps/web/src/app/(app)/settings/access/user-list.tsx b/apps/web/src/app/(app)/settings/access/user-list.tsx
new file mode 100644
index 00000000..6c45f908
--- /dev/null
+++ b/apps/web/src/app/(app)/settings/access/user-list.tsx
@@ -0,0 +1,226 @@
+"use client";
+
+import { groupCoverage } from "@/lib/access-model";
+import { GROUPS, type PermissionGroup } from "@/lib/permissions";
+
+import type { AppUserRow } from "./actions";
+import { Avatar } from "./avatar";
+
+export type UserFilter = "all" | "invited" | "none" | "admins";
+
+const FILTERS: readonly { id: UserFilter; label: string }[] = [
+  { id: "all", label: "Everyone" },
+  { id: "invited", label: "Invited" },
+  { id: "none", label: "No access" },
+  { id: "admins", label: "Admins" },
+];
+
+export function hasNoAccess(user: AppUserRow): boolean {
+  return user.role !== "admin" && Object.keys(user.pages).length === 0 && user.actions.length === 0;
+}
+
+export function matchesFilter(user: AppUserRow, filter: UserFilter): boolean {
+  if (filter === "invited") return user.status === "invited";
+  if (filter === "none") return hasNoAccess(user);
+  if (filter === "admins") return user.role === "admin";
+  return true;
+}
+
+const DOT_GROUPS: readonly { group: PermissionGroup; letter: string }[] = [
+  { group: "dashboard", letter: "H" },
+  { group: "demand", letter: "D" },
+  { group: "supply", letter: "S" },
+  { group: "reporting", letter: "R" },
+  { group: "agents", letter: "A" },
+];
+
+function GroupDots({ user }: { user: AppUserRow }) {
+  return (
+    <span className="flex items-center gap-0.5">
+      {DOT_GROUPS.map(({ group, letter }) => {
+        const cov = groupCoverage(user, group);
+        const tone =
+          cov.writes > 0
+            ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
+            : cov.withAccess > 0
+              ? "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300"
+              : "bg-slate-100 text-slate-300 dark:bg-slate-800 dark:text-slate-600";
+        const label = GROUPS.find((g) => g.key === group)?.label ?? group;
+        return (
+          <span
+            key={group}
+            title={`${label}: ${cov.withAccess} of ${cov.total} pages${cov.writes > 0 ? `, ${cov.writes} with write` : ""}`}
+            className={`inline-flex h-4 w-4 items-center justify-center rounded text-[9px] font-bold ${tone}`}
+          >
+            {letter}
+          </span>
+        );
+      })}
+    </span>
+  );
+}
+
+function Status({ user }: { user: AppUserRow }) {
+  if (user.role === "admin") {
+    return (
+      <span className="rounded bg-purple-100 px-1.5 py-px text-[10px] font-medium text-purple-700 dark:bg-purple-950 dark:text-purple-300">
+        Admin
+      </span>
+    );
+  }
+  if (hasNoAccess(user)) {
+    return (
+      <span className="text-[11px] italic text-amber-600 dark:text-amber-400">No access yet</span>
+    );
+  }
+  return (
+    <span className="flex items-center gap-1.5">
+      <GroupDots user={user} />
+      {user.actions.length > 0 && (
+        <span
+          title={`${user.actions.length} extra permission${user.actions.length === 1 ? "" : "s"}`}
+          className="rounded bg-amber-100 px-1 py-px text-[10px] font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-300"
+        >
+          +{user.actions.length}
+        </span>
+      )}
+    </span>
+  );
+}
+
+export function UserList({
+  users,
+  allUsers,
+  selected,
+  search,
+  filter,
+  onSearch,
+  onFilter,
+  onToggle,
+  onFocus,
+  onSelectAll,
+  onClearSelection,
+}: {
+  users: readonly AppUserRow[];
+  allUsers: readonly AppUserRow[];
+  selected: ReadonlySet<string>;
+  search: string;
+  filter: UserFilter;
+  onSearch: (value: string) => void;
+  onFilter: (value: UserFilter) => void;
+  onToggle: (email: string) => void;
+  onFocus: (email: string) => void;
+  onSelectAll: (emails: string[]) => void;
+  onClearSelection: () => void;
+}) {
+  const shownSelected = users.filter((u) => selected.has(u.email)).length;
+  const allShown = users.length > 0 && shownSelected === users.length;
+
+  return (
+    <div className="rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
+      <div className="space-y-2 border-b border-slate-100 p-2 dark:border-slate-800">
+        <input
+          type="search"
+          value={search}
+          onChange={(e) => onSearch(e.target.value)}
+          placeholder="Search people"
+          aria-label="Search people"
+          className="w-full rounded-md border border-slate-200 px-2.5 py-1.5 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-900"
+        />
+        <div className="flex flex-wrap gap-1">
+          {FILTERS.map((f) => {
+            const count = allUsers.filter((u) => matchesFilter(u, f.id)).length;
+            const active = filter === f.id;
+            return (
+              <button
+                key={f.id}
+                type="button"
+                aria-pressed={active}
+                onClick={() => onFilter(f.id)}
+                className={`rounded-full px-2.5 py-0.5 text-[11px] font-medium ${
+                  active
+                    ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900"
+                    : "bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300"
+                }`}
+              >
+                {f.label} <span className="opacity-60">{count}</span>
+              </button>
+            );
+          })}
+        </div>
+        <div className="flex items-center justify-between text-[11px] text-slate-500">
+          <label className="flex items-center gap-2">
+            <input
+              ref={(el) => {
+                if (el) el.indeterminate = shownSelected > 0 && !allShown;
+              }}
+              type="checkbox"
+              checked={allShown}
+              onChange={() =>
+                allShown ? onClearSelection() : onSelectAll(users.map((u) => u.email))
+              }
+              className="h-3.5 w-3.5 accent-blue-600"
+            />
+            {shownSelected > 0 ? `${shownSelected} selected` : `Select all ${users.length}`}
+          </label>
+          {selected.size > 0 && (
+            <button type="button" onClick={onClearSelection} className="hover:text-slate-800">
+              Clear selection
+            </button>
+          )}
+        </div>
+      </div>
+      <ul className="max-h-[calc(100vh-380px)] min-h-40 overflow-y-auto">
+        {users.map((user) => {
+          const [local, domain] = user.email.split("@");
+          return (
+            <li
+              key={user.email}
+              className={`flex items-center gap-2.5 border-t border-slate-50 px-2.5 py-2 first:border-t-0 dark:border-slate-800 ${
+                selected.has(user.email)
+                  ? "bg-blue-50 dark:bg-blue-950/30"
+                  : "hover:bg-slate-50 dark:hover:bg-slate-800/50"
+              }`}
+            >
+              <input
+                type="checkbox"
+                aria-label={`Select ${user.email}`}
+                checked={selected.has(user.email)}
+                onChange={() => onToggle(user.email)}
+                className="h-3.5 w-3.5 accent-blue-600"
+              />
+              <button
+                type="button"
+                onClick={() => onFocus(user.email)}
+                className="flex min-w-0 flex-1 items-center gap-2.5 text-left"
+              >
+                <Avatar email={user.email} />
+                <span className="min-w-0 flex-1">
+                  <span className="block truncate text-sm">
+                    <span className="font-medium text-slate-900 dark:text-slate-100">{local}</span>
+                    <span className="text-slate-400">@{domain}</span>
+                  </span>
+                  <span className="mt-0.5 flex items-center gap-2">
+                    <Status user={user} />
+                    {user.status === "invited" && (
+                      <span className="text-[10px] text-slate-400">Invited, not signed in</span>
+                    )}
+                  </span>
+                </span>
+              </button>
+            </li>
+          );
+        })}
+        {users.length === 0 && (
+          <li className="p-6 text-center text-xs text-slate-400">No one matches.</li>
+        )}
+      </ul>
+      <p className="border-t border-slate-100 px-3 py-2 text-[10px] text-slate-400 dark:border-slate-800">
+        H Home · D Demand · S Supply · R Reporting · A Agents.{" "}
+        <span className="text-blue-600">Blue</span> read,{" "}
+        <span className="text-emerald-600">green</span> write,{" "}
+        <span className="text-amber-600">+n</span> extra permissions.
+      </p>
+    </div>
+  );
+}
