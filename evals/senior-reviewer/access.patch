--- /dev/null
+++ b/apps/web/src/lib/access-model.ts
@@ -0,0 +1,166 @@
+import {
+  ACCESS_PAGES,
+  ACTION_KEYS,
+  type AccessPageId,
+  type ActionKey,
+  type LevelPageId,
+  type PageGrants,
+  type PageLevel,
+  type PermissionGroup,
+  groupOf,
+  isLevelPage,
+  levelsFor,
+  pageActions,
+} from "./permissions";
+
+export interface UserAccess {
+  pages: PageGrants;
+  actions: ActionKey[];
+}
+
+export type AccessChange =
+  | { kind: "page"; page: LevelPageId; level: PageLevel }
+  | { kind: "action"; action: ActionKey; granted: boolean };
+
+export function isAllowedChange(change: AccessChange): boolean {
+  return change.kind === "action" || levelsFor(change.page).includes(change.level);
+}
+
+function applyChange(access: UserAccess, change: AccessChange): UserAccess {
+  if (change.kind === "action") {
+    const rest = access.actions.filter((a) => a !== change.action);
+    return { pages: access.pages, actions: change.granted ? [...rest, change.action] : rest };
+  }
+  const { [change.page]: _removed, ...pages } = access.pages;
+  return {
+    pages: change.level === "none" ? pages : { ...pages, [change.page]: change.level },
+    actions: access.actions,
+  };
+}
+
+export function applyChanges(access: UserAccess, changes: readonly AccessChange[]): UserAccess {
+  return changes.reduce(applyChange, access);
+}
+
+export function grantCount(access: UserAccess): { pages: number; writes: number; actions: number } {
+  const levels = Object.values(access.pages);
+  return {
+    pages: levels.length,
+    writes: levels.filter((level) => level === "write").length,
+    actions: access.actions.length,
+  };
+}
+
+export function allPagesAt(level: PageLevel, pages: readonly AccessPageId[]): AccessChange[] {
+  return pages.filter(isLevelPage).map((page): AccessChange => {
+    const effective = level === "write" && !levelsFor(page).includes("write") ? "read" : level;
+    return { kind: "page", page, level: effective };
+  });
+}
+
+export function allActionsOn(pages: readonly AccessPageId[], granted: boolean): AccessChange[] {
+  return pages.flatMap((page) =>
+    pageActions(page).map((action): AccessChange => ({ kind: "action", action, granted }))
+  );
+}
+
+export const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+
+export interface InviteList {
+  valid: string[];
+  invalid: string[];
+  existing: string[];
+}
+
+export function parseInviteList(raw: string, known: readonly string[]): InviteList {
+  const tokens = [
+    ...new Set(
+      raw
+        .split(/[\s,;]+/)
+        .map((t) => t.trim().toLowerCase())
+        .filter(Boolean)
+    ),
+  ];
+  return {
+    invalid: tokens.filter((t) => !EMAIL_PATTERN.test(t)),
+    existing: tokens.filter((t) => EMAIL_PATTERN.test(t) && known.includes(t)),
+    valid: tokens.filter((t) => EMAIL_PATTERN.test(t) && !known.includes(t)),
+  };
+}
+
+export interface GroupCoverage {
+  total: number;
+  withAccess: number;
+  writes: number;
+}
+
+export function groupCoverage(access: UserAccess, group: PermissionGroup): GroupCoverage {
+  const pages = ACCESS_PAGES.filter(isLevelPage).filter((page) => groupOf(page) === group);
+  const levels = pages.map((page) => access.pages[page]);
+  return {
+    total: pages.length,
+    withAccess: levels.filter(Boolean).length,
+    writes: levels.filter((level) => level === "write").length,
+  };
+}
+
+export const CLEAR_ACCESS: AccessChange[] = [
+  ...allPagesAt("none", ACCESS_PAGES),
+  ...ACTION_KEYS.map((action): AccessChange => ({ kind: "action", action, granted: false })),
+];
+
+function pagesIn(...groups: PermissionGroup[]): AccessPageId[] {
+  return ACCESS_PAGES.filter((page) => groups.includes(groupOf(page)));
+}
+
+export interface AccessTemplate {
+  id: string;
+  label: string;
+  description: string;
+  changes: AccessChange[];
+}
+
+export const ACCESS_TEMPLATES: readonly AccessTemplate[] = [
+  {
+    id: "read-only",
+    label: "Read-only everywhere",
+    description: "Can open every page but change nothing",
+    changes: [...CLEAR_ACCESS, ...allPagesAt("read", ACCESS_PAGES)],
+  },
+  {
+    id: "reports",
+    label: "Reports only",
+    description: "Dashboard and every report, read-only",
+    changes: [...CLEAR_ACCESS, ...allPagesAt("read", pagesIn("dashboard", "reporting"))],
+  },
+  {
+    id: "demand-planner",
+    label: "Demand planner",
+    description: "Edits demand; reads supply and reports",
+    changes: [
+      ...CLEAR_ACCESS,
+      ...allPagesAt("read", ACCESS_PAGES),
+      ...allPagesAt("write", pagesIn("demand")),
+    ],
+  },
+  {
+    id: "supply-planner",
+    label: "Supply planner",
+    description: "Edits supply; reads demand and reports",
+    changes: [
+      ...CLEAR_ACCESS,
+      ...allPagesAt("read", ACCESS_PAGES),
+      ...allPagesAt("write", pagesIn("supply")),
+    ],
+  },
+  {
+    id: "planner",
+    label: "Demand & supply planner",
+    description: "Edits demand and supply; reads reports",
+    changes: [
+      ...CLEAR_ACCESS,
+      ...allPagesAt("read", ACCESS_PAGES),
+      ...allPagesAt("write", pagesIn("demand", "supply")),
+    ],
+  },
+];
