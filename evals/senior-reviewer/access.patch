diff --git a/apps/web/src/app/(app)/settings/access/permission-editor.tsx b/apps/web/src/app/(app)/settings/access/permission-editor.tsx
new file mode 100644
index 00000000..1153ec13
--- /dev/null
+++ b/apps/web/src/app/(app)/settings/access/permission-editor.tsx
@@ -0,0 +1,238 @@
+"use client";
+
+import { type AccessChange, allActionsOn, allPagesAt, groupCoverage } from "@/lib/access-model";
+import {
+  ACCESS_PAGES,
+  type AccessPageId,
+  GROUPS,
+  type PageLevel,
+  actionLabel,
+  grantLevel,
+  groupOf,
+  isLevelPage,
+  levelsFor,
+  pageActions,
+  pageDescription,
+} from "@/lib/permissions";
+import { PAGES } from "@/lib/routes";
+
+import type { AppUserRow } from "./actions";
+import { LevelControl } from "./level-control";
+import { TriCheckbox, triState } from "./tri-checkbox";
+
+const LEVEL_WORDS: Record<PageLevel, string> = {
+  none: "none",
+  read: "read",
+  write: "read & write",
+};
+
+type ChangeHandler = (changes: AccessChange[], label: string) => void;
+
+function levelSummary(targets: readonly AppUserRow[], page: AccessPageId) {
+  const counts = new Map<PageLevel, number>();
+  for (const user of targets) {
+    const level = grantLevel(user.pages, page);
+    counts.set(level, (counts.get(level) ?? 0) + 1);
+  }
+  const value = counts.size === 1 ? ([...counts.keys()][0] ?? "none") : "mixed";
+  const hint = [...counts.entries()].map(([level, n]) => `${n} ${LEVEL_WORDS[level]}`).join(", ");
+  return { value, hint } as const;
+}
+
+function matches(page: AccessPageId, query: string): boolean {
+  if (!query) return true;
+  const haystack = [PAGES[page].label, pageDescription(page), ...pageActions(page).map(actionLabel)]
+    .join(" ")
+    .toLowerCase();
+  return haystack.includes(query);
+}
+
+function hasAccess(page: AccessPageId, targets: readonly AppUserRow[]): boolean {
+  return targets.some(
+    (u) =>
+      grantLevel(u.pages, page) !== "none" || pageActions(page).some((a) => u.actions.includes(a))
+  );
+}
+
+function PageRow({
+  page,
+  targets,
+  onChange,
+}: {
+  page: AccessPageId;
+  targets: readonly AppUserRow[];
+  onChange: ChangeHandler;
+}) {
+  const actions = pageActions(page);
+  const summary = levelSummary(targets, page);
+  return (
+    <div className="border-t border-slate-100 py-2.5 first:border-t-0 dark:border-slate-800">
+      <div className="flex flex-wrap items-start gap-x-4 gap-y-1.5">
+        <div className="min-w-0 flex-1 basis-56">
+          <div className="flex items-center gap-1.5">
+            <span className="text-sm font-medium text-slate-800 dark:text-slate-100">
+              {PAGES[page].label}
+            </span>
+            <a
+              href={PAGES[page].path}
+              target="_blank"
+              rel="noreferrer"
+              title="Open this page in a new tab"
+              aria-label={`Open ${PAGES[page].label}`}
+              className="text-[11px] text-slate-300 hover:text-blue-600"
+            >
+              ↗
+            </a>
+          </div>
+          <div className="text-xs text-slate-500">{pageDescription(page)}</div>
+        </div>
+        {isLevelPage(page) ? (
+          <div className="flex items-center gap-2">
+            {summary.value === "mixed" && (
+              <span
+                title={summary.hint}
+                className="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-300"
+              >
+                Mixed
+              </span>
+            )}
+            <LevelControl
+              label={`${PAGES[page].label} access`}
+              levels={levelsFor(page)}
+              value={summary.value}
+              onChange={(level) =>
+                onChange(
+                  [{ kind: "page", page, level }],
+                  `${PAGES[page].label}: ${level === "none" ? "no access" : LEVEL_WORDS[level]}`
+                )
+              }
+            />
+          </div>
+        ) : (
+          <span className="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-500 dark:bg-slate-800">
+            Open only through extra permissions
+          </span>
+        )}
+      </div>
+      {actions.length > 0 && (
+        <div className="mt-2 space-y-1 rounded-md border border-amber-200/70 bg-amber-50/50 px-2.5 py-1.5 dark:border-amber-900/50 dark:bg-amber-950/10">
+          <div className="text-[10px] font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400">
+            Extra permissions
+          </div>
+          {actions.map((action) => (
+            <TriCheckbox
+              key={action}
+              state={triState(targets.map((u) => u.actions.includes(action)))}
+              onChange={(granted) =>
+                onChange(
+                  [{ kind: "action", action, granted }],
+                  `${actionLabel(action)}: ${granted ? "granted" : "removed"}`
+                )
+              }
+            >
+              {actionLabel(action)}
+            </TriCheckbox>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+const PRESETS: { level: PageLevel; label: string }[] = [
+  { level: "none", label: "None" },
+  { level: "read", label: "Read all" },
+  { level: "write", label: "Write all" },
+];
+
+export function PermissionEditor({
+  targets,
+  query,
+  onlyWithAccess,
+  onChange,
+}: {
+  targets: readonly AppUserRow[];
+  query: string;
+  onlyWithAccess: boolean;
+  onChange: ChangeHandler;
+}) {
+  const needle = query.trim().toLowerCase();
+  const single = targets.length === 1 ? targets[0] : undefined;
+  const groups = GROUPS.map((group) => ({
+    ...group,
+    pages: ACCESS_PAGES.filter(
+      (page) =>
+        groupOf(page) === group.key &&
+        matches(page, needle) &&
+        (!onlyWithAccess || hasAccess(page, targets))
+    ),
+    allPages: ACCESS_PAGES.filter((page) => groupOf(page) === group.key),
+  })).filter((group) => group.pages.length > 0);
+
+  if (groups.length === 0) {
+    return (
+      <div className="rounded-lg border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 dark:border-slate-700">
+        No pages match your filter.
+      </div>
+    );
+  }
+
+  return (
+    <div className="space-y-3">
+      {groups.map((group) => {
+        const coverage = single ? groupCoverage(single, group.key) : null;
+        return (
+          <details
+            key={group.key}
+            open
+            className="group rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900"
+          >
+            <summary className="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2 [&::-webkit-details-marker]:hidden">
+              <span
+                aria-hidden
+                className="text-[9px] text-slate-400 transition-transform group-open:rotate-90"
+              >
+                ▶
+              </span>
+              <h3 className="text-xs font-semibold uppercase tracking-wide text-slate-600 dark:text-slate-300">
+                {group.label}
+              </h3>
+              {coverage && coverage.total > 0 && (
+                <span className="text-[11px] text-slate-400">
+                  {coverage.withAccess} of {coverage.total} pages
+                  {coverage.writes > 0 && ` · ${coverage.writes} with write`}
+                </span>
+              )}
+              <span className="ml-auto flex items-center gap-1">
+                {PRESETS.map((preset) => (
+                  <button
+                    key={preset.level}
+                    type="button"
+                    onClick={(e) => {
+                      e.preventDefault();
+                      onChange(
+                        [
+                          ...allPagesAt(preset.level, group.allPages),
+                          ...(preset.level === "none" ? allActionsOn(group.allPages, false) : []),
+                        ],
+                        `${group.label}: ${preset.label.toLowerCase()}`
+                      );
+                    }}
+                    className="rounded px-2 py-0.5 text-[11px] text-slate-500 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-blue-500 dark:hover:bg-slate-800"
+                  >
+                    {preset.label}
+                  </button>
+                ))}
+              </span>
+            </summary>
+            <div className="border-t border-slate-100 px-3 dark:border-slate-800">
+              {group.pages.map((page) => (
+                <PageRow key={page} page={page} targets={targets} onChange={onChange} />
+              ))}
+            </div>
+          </details>
+        );
+      })}
+    </div>
+  );
+}
