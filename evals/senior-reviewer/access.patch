diff --git a/apps/web/src/lib/access-model.test.ts b/apps/web/src/lib/access-model.test.ts
new file mode 100644
index 00000000..67430233
--- /dev/null
+++ b/apps/web/src/lib/access-model.test.ts
@@ -0,0 +1,140 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  ACCESS_TEMPLATES,
+  type UserAccess,
+  allActionsOn,
+  allPagesAt,
+  applyChanges,
+  grantCount,
+  groupCoverage,
+  isAllowedChange,
+  parseInviteList,
+} from "./access-model";
+
+const empty: UserAccess = { pages: {}, actions: [] };
+
+function template(id: string) {
+  const found = ACCESS_TEMPLATES.find((t) => t.id === id);
+  if (!found) throw new Error(`no template ${id}`);
+  return found;
+}
+
+describe("applyChanges", () => {
+  it("sets and clears a page level", () => {
+    const written = applyChanges(empty, [
+      { kind: "page", page: "supply.supply-plan", level: "write" },
+    ]);
+    expect(written.pages).toEqual({ "supply.supply-plan": "write" });
+    const cleared = applyChanges(written, [
+      { kind: "page", page: "supply.supply-plan", level: "none" },
+    ]);
+    expect(cleared.pages).toEqual({});
+  });
+
+  it("grants an action once and revokes it", () => {
+    const granted = applyChanges(empty, [
+      { kind: "action", action: "supply.po.submit", granted: true },
+      { kind: "action", action: "supply.po.submit", granted: true },
+    ]);
+    expect(granted.actions).toEqual(["supply.po.submit"]);
+    const revoked = applyChanges(granted, [
+      { kind: "action", action: "supply.po.submit", granted: false },
+    ]);
+    expect(revoked.actions).toEqual([]);
+  });
+});
+
+describe("group presets", () => {
+  it("caps read-only pages at read when asked for write on a whole group", () => {
