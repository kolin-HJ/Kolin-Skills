diff --git a/apps/web/src/app/(app)/settings/access/access-manager.tsx b/apps/web/src/app/(app)/settings/access/access-manager.tsx
new file mode 100644
index 00000000..a376e41d
--- /dev/null
+++ b/apps/web/src/app/(app)/settings/access/access-manager.tsx
@@ -0,0 +1,446 @@
+"use client";
+
+import { useCallback, useMemo, useRef, useState } from "react";
+
+import {
+  ACCESS_TEMPLATES,
+  type AccessChange,
+  type AccessTemplate,
+  CLEAR_ACCESS,
+  type UserAccess,
+  applyChanges,
+  grantCount,
+} from "@/lib/access-model";
+
+import { AccessMatrix } from "./access-matrix";
+import {
+  type AccessSnapshot,
+  type ActionResult,
+  type AppUserRow,
+  applyAccessChanges,
+  copyAccess,
+  inviteUsers,
+  listAppUsers,
+  restoreAccess,
+  revokeUsers,
+} from "./actions";
+import { Avatar } from "./avatar";
+import { ConfirmDialog } from "./confirm-dialog";
+import { InvitePanel } from "./invite-panel";
+import { Menu, MenuItem } from "./menu";
+import { PermissionEditor } from "./permission-editor";
+import { Toast, type ToastState } from "./toast";
+import { type UserFilter, UserList, hasNoAccess, matchesFilter } from "./user-list";
+
+type View = "people" | "matrix";
+
+function snapshotOf(user: AppUserRow): AccessSnapshot {
+  return { email: user.email, pages: user.pages, actions: user.actions };
+}
+
+function peopleLabel(users: readonly AppUserRow[]): string {
+  return users.length === 1 ? (users[0]?.email ?? "") : `${users.length} people`;
+}
+
+function accessSummary(user: AppUserRow): string {
+  const { pages, writes, actions } = grantCount(user);
+  if (pages === 0 && actions === 0) return "No access";
+  return `${pages} pages · ${writes} with write${actions > 0 ? ` · ${actions} extra` : ""}`;
+}
+
+export function AccessManager({ initialUsers }: { initialUsers: AppUserRow[] }) {
+  const [users, setUsers] = useState<AppUserRow[]>(initialUsers);
+  const [selected, setSelected] = useState<ReadonlySet<string>>(new Set());
+  const [view, setView] = useState<View>("people");
+  const [search, setSearch] = useState("");
+  const [filter, setFilter] = useState<UserFilter>("all");
+  const [pageQuery, setPageQuery] = useState("");
+  const [onlyWithAccess, setOnlyWithAccess] = useState(false);
+  const [inviteOpen, setInviteOpen] = useState(false);
+  const [confirmRemove, setConfirmRemove] = useState(false);
+  const [toast, setToast] = useState<ToastState | null>(null);
+  const [pending, setPending] = useState(0);
+  const toastId = useRef(0);
+  const editorRef = useRef<HTMLDivElement>(null);
+
+  const visible = useMemo(() => {
+    const q = search.trim().toLowerCase();
+    return users.filter((u) => matchesFilter(u, filter) && (!q || u.email.includes(q)));
+  }, [users, search, filter]);
+
+  const selectedUsers = users.filter((u) => selected.has(u.email));
+  const editable = selectedUsers.filter((u) => u.role !== "admin");
+  const adminCount = selectedUsers.length - editable.length;
+  const copySources = users.filter((u) => u.role !== "admin" && !selected.has(u.email));
+  const single = selectedUsers.length === 1 ? selectedUsers[0] : undefined;
+
+  const stats = {
+    admins: users.filter((u) => u.role === "admin").length,
+    invited: users.filter((u) => u.status === "invited").length,
+    none: users.filter(hasNoAccess).length,
+  };
+
+  const announce = useCallback(
+    (text: string, onUndo?: () => void, tone: "info" | "error" = "info") => {
+      toastId.current += 1;
+      setToast({ id: toastId.current, text, tone, undo: onUndo });
+    },
+    []
+  );
+  const dismissToast = useCallback(() => setToast(null), []);
+
+  async function resync() {
+    setUsers(await listAppUsers());
+  }
+
+  async function run(op: () => Promise<ActionResult>) {
+    setPending((n) => n + 1);
+    try {
+      const res = await op();
+      if (!res.ok) {
+        announce(res.error, undefined, "error");
+        await resync();
+      }
+    } catch {
+      announce("Could not save. Showing the latest saved permissions.", undefined, "error");
+      await resync();
+    } finally {
+      setPending((n) => n - 1);
+    }
+  }
+
+  function undo(before: AccessSnapshot[]) {
+    setUsers((prev) =>
+      prev.map((u) => {
+        const snap = before.find((b) => b.email === u.email);
+        return snap ? { ...u, pages: snap.pages, actions: snap.actions } : u;
+      })
+    );
+    announce("Change undone");
+    void run(() => restoreAccess(before));
+  }
+
+  async function mutate(
+    emails: readonly string[],
+    label: string,
+    compute: (access: UserAccess) => UserAccess,
+    send: () => Promise<ActionResult>
+  ) {
+    const targets = users.filter((u) => emails.includes(u.email) && u.role !== "admin");
+    if (targets.length === 0) return;
+    const before = targets.map(snapshotOf);
+    const targetEmails = new Set(targets.map((t) => t.email));
+    setUsers((prev) => prev.map((u) => (targetEmails.has(u.email) ? { ...u, ...compute(u) } : u)));
+    announce(`${label} · ${peopleLabel(targets)}`, () => undo(before));
+    await run(send);
+  }
+
+  function change(emails: readonly string[], changes: AccessChange[], label: string) {
+    void mutate(
+      emails,
+      label,
+      (access) => applyChanges(access, changes),
+      () => applyAccessChanges([...emails], changes)
+    );
+  }
+
+  const editEmails = editable.map((u) => u.email);
+
+  function applyTemplate(template: AccessTemplate) {
+    change(editEmails, template.changes, `Applied “${template.label}”`);
+  }
+
+  function copyFrom(source: AppUserRow) {
+    void mutate(
+      editEmails,
+      `Copied access from ${source.email}`,
+      () => ({ pages: source.pages, actions: source.actions }),
+      () => copyAccess(source.email, editEmails)
+    );
+  }
+
+  async function invite(emails: string[]): Promise<boolean> {
+    setPending((n) => n + 1);
+    try {
+      const res = await inviteUsers(emails);
+      if (!res.ok || !res.result) {
+        announce(res.ok ? "Nothing to invite" : res.error, undefined, "error");
+        return false;
+      }
+      const { invited, skipped } = res.result;
+      await resync();
+      setSelected(new Set(invited));
+      setView("people");
+      setInviteOpen(false);
+      announce(
+        invited.length > 0
+          ? `Invited ${invited.length === 1 ? invited[0] : `${invited.length} people`}. Choose their access on the right.${skipped.length > 0 ? ` Skipped ${skipped.length}.` : ""}`
+          : `Nobody new to invite (${skipped.map((s) => s.reason).join(", ")})`
+      );
+      return invited.length > 0;
+    } finally {
+      setPending((n) => n - 1);
+    }
+  }
+
+  function remove() {
+    const emails = selectedUsers.map((u) => u.email);
+    setConfirmRemove(false);
+    setUsers((prev) => prev.filter((u) => !emails.includes(u.email)));
+    setSelected(new Set());
+    announce(`Removed ${peopleLabel(selectedUsers)}`);
+    void run(() => revokeUsers(emails));
+  }
+
+  function toggle(email: string) {
+    setSelected((prev) => {
+      const next = new Set(prev);
+      if (next.has(email)) next.delete(email);
+      else next.add(email);
+      return next;
+    });
+  }
+
+  function focusUser(email: string) {
+    setSelected(new Set([email]));
+    setView("people");
+    if (window.innerWidth < 1024) {
+      requestAnimationFrame(() => editorRef.current?.scrollIntoView({ behavior: "smooth" }));
+    }
+  }
+
+  return (
+    <div className="space-y-4">
+      <div className="flex flex-wrap items-center gap-3">
+        <p className="text-sm text-slate-600 dark:text-slate-300">
+          <b className="text-slate-900 dark:text-slate-100">{users.length}</b> people
+          <span className="text-slate-400"> · </span>
+          {stats.admins} admins
+          <span className="text-slate-400"> · </span>
+          {stats.invited} invited
+          <span className="text-slate-400"> · </span>
+          <button
+            type="button"
+            onClick={() => {
+              setFilter("none");
+              setView("people");
+            }}
+            className={stats.none > 0 ? "text-amber-600 hover:underline" : "text-slate-500"}
+          >
+            {stats.none} with no access
+          </button>
+        </p>
+        <span className="text-xs text-slate-400" aria-live="polite">
+          {pending > 0 ? "Saving…" : ""}
+        </span>
+        <div className="ml-auto flex flex-wrap items-center gap-2">
+          <button
+            type="button"
+            onClick={() => setInviteOpen((open) => !open)}
+            aria-expanded={inviteOpen}
+            className="whitespace-nowrap rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1"
+          >
+            + Invite people
+          </button>
+          <div className="inline-flex overflow-hidden rounded-md border border-slate-200 text-sm dark:border-slate-700">
+            {(["people", "matrix"] as const).map((v) => (
+              <button
+                key={v}
+                type="button"
+                onClick={() => setView(v)}
+                aria-pressed={view === v}
+                className={`whitespace-nowrap px-3 py-1.5 ${
+                  view === v
+                    ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900"
+                    : "text-slate-600 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-800"
+                }`}
+              >
+                {v === "people" ? "Edit access" : "Who has what"}
+              </button>
+            ))}
+          </div>
+        </div>
+      </div>
+
+      {inviteOpen && (
+        <InvitePanel
+          known={users.map((u) => u.email)}
+          busy={pending > 0}
+          onInvite={invite}
+          onClose={() => setInviteOpen(false)}
+        />
+      )}
+
+      {view === "matrix" ? (
+        <AccessMatrix users={users} selected={selected} onOpen={focusUser} onChange={change} />
+      ) : (
+        <div className="grid grid-cols-1 items-start gap-4 lg:grid-cols-[360px_minmax(0,1fr)]">
+          <div className="lg:sticky lg:top-2">
+            <UserList
+              users={visible}
+              allUsers={users}
+              selected={selected}
+              search={search}
+              filter={filter}
+              onSearch={setSearch}
+              onFilter={setFilter}
+              onToggle={toggle}
+              onFocus={focusUser}
+              onSelectAll={(emails) => setSelected(new Set(emails))}
+              onClearSelection={() => setSelected(new Set())}
+            />
+          </div>
+
+          <div ref={editorRef} className="min-w-0 scroll-mt-4">
+            {selectedUsers.length === 0 ? (
+              <div className="rounded-lg border border-dashed border-slate-300 p-12 text-center dark:border-slate-700">
+                <p className="text-sm font-medium text-slate-700 dark:text-slate-200">
+                  Pick someone to get started
+                </p>
+                <p className="mx-auto mt-1 max-w-sm text-sm text-slate-500">
+                  Select one person to edit their access, or tick several to change them all at
+                  once. Everything saves as you click, and you can undo it.
+                </p>
+              </div>
+            ) : (
+              <div className="space-y-3">
+                <div className="sticky top-0 z-10 -mx-1 space-y-2 bg-slate-50/95 px-1 pb-2 pt-1 backdrop-blur dark:bg-slate-950/90">
+                  <div className="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2.5 dark:border-slate-700 dark:bg-slate-900">
+                    {single ? <Avatar email={single.email} size="lg" /> : null}
+                    <div className="min-w-0 flex-1 basis-56">
+                      <div className="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">
+                        {single ? single.email : `${selectedUsers.length} people selected`}
+                      </div>
+                      <div className="text-[11px] text-slate-500">
+                        {single
+                          ? single.role === "admin"
+                            ? "Admin · full access to everything"
+                            : accessSummary(single)
+                          : "Changes apply to everyone selected. “Mixed” means they currently differ."}
+                        {adminCount > 0 && single === undefined
+                          ? ` ${adminCount} admin${adminCount === 1 ? "" : "s"} skipped (always full access).`
+                          : ""}
+                      </div>
+                    </div>
+                    <div className="flex flex-wrap items-center gap-2">
+                      <Menu label="Apply template" disabled={editable.length === 0}>
+                        {(close) => (
+                          <>
+                            <p className="px-2.5 pb-1 pt-1.5 text-[11px] text-slate-500">
+                              Replaces page access. Extra permissions are cleared and never
+                              included.
+                            </p>
+                            {ACCESS_TEMPLATES.map((t) => (
+                              <MenuItem
+                                key={t.id}
+                                title={t.label}
+                                detail={t.description}
+                                onSelect={() => {
+                                  close();
+                                  applyTemplate(t);
+                                }}
+                              />
+                            ))}
+                          </>
+                        )}
+                      </Menu>
+                      <Menu label="Copy from…" disabled={editable.length === 0}>
+                        {(close) =>
+                          copySources.length === 0 ? (
+                            <p className="p-2.5 text-xs text-slate-500">
+                              No one else to copy from.
+                            </p>
+                          ) : (
+                            copySources.map((u) => (
+                              <MenuItem
+                                key={u.email}
+                                title={u.email}
+                                detail={accessSummary(u)}
+                                onSelect={() => {
+                                  close();
+                                  copyFrom(u);
+                                }}
+                              />
+                            ))
+                          )
+                        }
+                      </Menu>
+                      <button
+                        type="button"
+                        disabled={editable.length === 0}
+                        onClick={() => change(editEmails, CLEAR_ACCESS, "Cleared all access")}
+                        className="rounded-md border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
+                      >
+                        Clear all
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setConfirmRemove(true)}
+                        className="rounded-md border border-red-200 px-2.5 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 dark:border-red-900 dark:hover:bg-red-950"
+                      >
+                        Remove
+                      </button>
+                    </div>
+                  </div>
+                  {editable.length > 0 && (
+                    <div className="flex flex-wrap items-center gap-3">
+                      <input
+                        type="search"
+                        value={pageQuery}
+                        onChange={(e) => setPageQuery(e.target.value)}
+                        placeholder="Filter pages, e.g. “PO” or “inventory”"
+                        aria-label="Filter pages"
+                        className="min-w-48 flex-1 rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-900"
+                      />
+                      <label className="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
+                        <input
+                          type="checkbox"
+                          checked={onlyWithAccess}
+                          onChange={(e) => setOnlyWithAccess(e.target.checked)}
+                          className="h-3.5 w-3.5 accent-blue-600"
+                        />
+                        Only pages with access
+                      </label>
+                    </div>
+                  )}
+                  {editable.length > 0 && (
+                    <p className="text-[11px] text-slate-500">
+                      <b>Read</b> opens and views a page. <b>Read &amp; write</b> also lets them
+                      make changes (it includes read). <b>Extra permissions</b> are separate,
+                      higher-risk grants.
+                    </p>
+                  )}
+                </div>
+                {editable.length > 0 ? (
+                  <PermissionEditor
+                    targets={editable}
+                    query={pageQuery}
+                    onlyWithAccess={onlyWithAccess}
+                    onChange={(changes, label) => change(editEmails, changes, label)}
+                  />
+                ) : (
+                  <div className="rounded-lg border border-slate-200 p-6 text-sm text-slate-500 dark:border-slate-700">
+                    Admins have full access to every page and extra permission, so there is nothing
+                    to edit.
+                  </div>
+                )}
+              </div>
+            )}
+          </div>
+        </div>
+      )}
+
+      <ConfirmDialog
+        open={confirmRemove}
+        title={`Remove ${peopleLabel(selectedUsers)}?`}
+        confirmLabel="Remove"
+        onConfirm={remove}
+        onCancel={() => setConfirmRemove(false)}
+      >
+        They will no longer be able to sign in, and all of their page access and extra permissions
+        are deleted. Inviting them again starts from no access. This can't be undone.
+      </ConfirmDialog>
+      <Toast toast={toast} onDismiss={dismissToast} />
+    </div>
+  );
+}
diff --git a/apps/web/src/app/(app)/settings/access/access-matrix.tsx b/apps/web/src/app/(app)/settings/access/access-matrix.tsx
new file mode 100644
index 00000000..7c682dc6
--- /dev/null
+++ b/apps/web/src/app/(app)/settings/access/access-matrix.tsx
@@ -0,0 +1,246 @@
+"use client";
+
+import { useState } from "react";
+
+import type { AccessChange } from "@/lib/access-model";
+import {
+  ACCESS_PAGES,
+  type AccessPageId,
+  GROUPS,
+  type PageLevel,
+  type PermissionGroup,
+  actionLabel,
+  grantLevel,
+  groupOf,
+  isLevelPage,
+  levelsFor,
+  pageActions,
+  pageDescription,
+} from "@/lib/permissions";
+import { PAGES } from "@/lib/routes";
+
+import type { AppUserRow } from "./actions";
+import { Avatar } from "./avatar";
+
+const GROUP_TINT: Record<PermissionGroup, string> = {
+  dashboard: "bg-slate-50 dark:bg-slate-800/60",
+  demand: "bg-sky-50/70 dark:bg-sky-950/30",
+  supply: "bg-amber-50/70 dark:bg-amber-950/30",
+  reporting: "bg-violet-50/70 dark:bg-violet-950/30",
+  agents: "bg-teal-50/70 dark:bg-teal-950/30",
+  admin: "bg-rose-50/70 dark:bg-rose-950/30",
+};
+
+const LEVEL_WORDS: Record<PageLevel, string> = {
+  none: "no access",
+  read: "read",
+  write: "read & write",
+};
+
+function nextLevel(page: AccessPageId, current: PageLevel): PageLevel {
+  const levels = levelsFor(page);
+  return levels[(levels.indexOf(current) + 1) % levels.length] ?? "none";
+}
+
+function Cell({
+  user,
+  page,
+  onCycle,
+  onOpen,
+}: {
+  user: AppUserRow;
+  page: AccessPageId;
+  onCycle: () => void;
+  onOpen: () => void;
+}) {
+  const level = grantLevel(user.pages, page);
+  const held = pageActions(page).filter((a) => user.actions.includes(a));
+  const levelPage = isLevelPage(page);
+  const title = [
+    `${user.email} · ${PAGES[page].label}`,
+    levelPage
+      ? `${LEVEL_WORDS[level]} (click to change)`
+      : "extra permissions only (click to open)",
+    ...held.map((a) => `Extra: ${actionLabel(a)}`),
+  ].join("\n");
+  return (
+    <td className="h-8 w-9 min-w-9 border-l border-t border-slate-100 p-0 text-center dark:border-slate-800">
+      <button
+        type="button"
+        title={title}
+        aria-label={title.replace("\n", ", ")}
+        onClick={levelPage ? onCycle : onOpen}
+        className="flex h-full w-full items-center justify-center gap-0.5 text-[10px] font-semibold hover:bg-blue-50 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500 dark:hover:bg-blue-950/40"
+      >
+        {level === "write" && (
+          <span className="rounded bg-emerald-100 px-1 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
+            RW
+          </span>
+        )}
+        {level === "read" && (
+          <span className="rounded bg-blue-100 px-1 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
+            R
+          </span>
+        )}
+        {level === "none" && levelPage && (
+          <span className="text-slate-200 dark:text-slate-700">·</span>
+        )}
+        {held.length > 0 && <span className="text-amber-500">●</span>}
+      </button>
+    </td>
+  );
+}
+
+export function AccessMatrix({
+  users,
+  selected,
+  onOpen,
+  onChange,
+}: {
+  users: readonly AppUserRow[];
+  selected: ReadonlySet<string>;
+  onOpen: (email: string) => void;
+  onChange: (emails: string[], changes: AccessChange[], label: string) => void;
+}) {
+  const [shown, setShown] = useState<ReadonlySet<PermissionGroup>>(
+    new Set(GROUPS.map((g) => g.key))
+  );
+
+  const visibleGroups = GROUPS.filter((g) => shown.has(g.key));
+  const pages = ACCESS_PAGES.filter((p) => shown.has(groupOf(p)));
+
+  function toggleGroup(group: PermissionGroup) {
+    setShown((prev) => {
+      const next = new Set(prev);
+      if (next.has(group)) next.delete(group);
+      else next.add(group);
+      return next;
+    });
+  }
+
+  return (
+    <div className="space-y-2">
+      <div className="flex flex-wrap items-center gap-2 text-xs">
+        <span className="text-slate-500">Show</span>
+        {GROUPS.map((group) => (
+          <button
+            key={group.key}
+            type="button"
+            aria-pressed={shown.has(group.key)}
+            onClick={() => toggleGroup(group.key)}
+            className={`rounded-full px-2.5 py-0.5 font-medium ${
+              shown.has(group.key)
+                ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900"
+                : "bg-slate-100 text-slate-500 hover:bg-slate-200 dark:bg-slate-800"
+            }`}
+          >
+            {group.label}
+          </button>
+        ))}
+        <span className="ml-auto flex flex-wrap items-center gap-3 text-[11px] text-slate-500">
+          <span>
+            <b className="rounded bg-blue-100 px-1 text-blue-700">R</b> read
+          </span>
+          <span>
+            <b className="rounded bg-emerald-100 px-1 text-emerald-700">RW</b> read &amp; write
+          </span>
+          <span>
+            <b className="text-amber-500">●</b> extra permission
+          </span>
+          <span>Click a cell to change it; every change can be undone.</span>
+        </span>
+      </div>
+      <div className="max-h-[calc(100vh-260px)] overflow-auto rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
+        <table className="border-separate border-spacing-0 text-xs">
+          <thead className="sticky top-0 z-20">
+            <tr>
+              <th
+                className="sticky left-0 z-30 min-w-[250px] bg-white dark:bg-slate-900"
+                rowSpan={2}
+              >
+                <span className="sr-only">Person</span>
+              </th>
+              {visibleGroups.map((group) => {
+                const count = pages.filter((p) => groupOf(p) === group.key).length;
+                return (
+                  <th
+                    key={group.key}
+                    colSpan={count}
+                    className={`border-l border-slate-200 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:border-slate-700 ${GROUP_TINT[group.key]}`}
+                  >
+                    {group.label}
+                  </th>
+                );
+              })}
+            </tr>
+            <tr>
+              {pages.map((page) => (
+                <th
+                  key={page}
+                  title={pageDescription(page)}
+                  className={`h-36 w-9 min-w-9 border-l border-slate-200 pb-2 align-bottom dark:border-slate-700 ${GROUP_TINT[groupOf(page)]}`}
+                >
+                  <span className="inline-block rotate-180 whitespace-nowrap text-[11px] font-medium text-slate-600 [writing-mode:vertical-rl] dark:text-slate-300">
+                    {PAGES[page].label}
+                  </span>
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {users.map((user) => {
+              const isAdmin = user.role === "admin";
+              return (
+                <tr
+                  key={user.email}
+                  className={`group ${selected.has(user.email) ? "bg-blue-50/60 dark:bg-blue-950/20" : "hover:bg-slate-50 dark:hover:bg-slate-800/40"}`}
+                >
+                  <th
+                    scope="row"
+                    className={`sticky left-0 z-10 border-t border-slate-100 bg-white px-3 text-left font-normal dark:border-slate-800 dark:bg-slate-900`}
+                  >
+                    <button
+                      type="button"
+                      onClick={() => onOpen(user.email)}
+                      title="Open in the editor"
+                      className="flex w-full items-center gap-2 py-1 text-left text-slate-700 hover:text-blue-600 dark:text-slate-200"
+                    >
+                      <Avatar email={user.email} />
+                      <span className="truncate">{user.email}</span>
+                    </button>
+                  </th>
+                  {isAdmin ? (
+                    <td
+                      colSpan={pages.length}
+                      className="h-8 border-t border-slate-100 bg-purple-50/60 px-3 text-[11px] text-purple-700 dark:border-slate-800 dark:bg-purple-950/20 dark:text-purple-300"
+                    >
+                      Admin: full access to every page and extra permission
+                    </td>
+                  ) : (
+                    pages.map((page) => (
+                      <Cell
+                        key={page}
+                        user={user}
+                        page={page}
+                        onOpen={() => onOpen(user.email)}
+                        onCycle={() => {
+                          if (!isLevelPage(page)) return;
+                          const level = nextLevel(page, grantLevel(user.pages, page));
+                          onChange(
+                            [user.email],
+                            [{ kind: "page", page, level }],
+                            `${PAGES[page].label}: ${LEVEL_WORDS[level]}`
+                          );
+                        }}
+                      />
+                    ))
+                  )}
+                </tr>
+              );
+            })}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/app/(app)/settings/access/actions.ts b/apps/web/src/app/(app)/settings/access/actions.ts
new file mode 100644
index 00000000..764983f9
--- /dev/null
+++ b/apps/web/src/app/(app)/settings/access/actions.ts
@@ -0,0 +1,345 @@
+"use server";
+
+import { getDb, schema } from "@hj/db";
+import { and, eq, inArray, ne } from "drizzle-orm";
+import { revalidatePath } from "next/cache";
+import { z } from "zod";
+
+import { type AccessChange, EMAIL_PATTERN, isAllowedChange } from "@/lib/access-model";
+import { getAppUser } from "@/lib/auth";
+import { AuthzError, requireCapability } from "@/lib/authz";
+import { serverAction } from "@/lib/parse-input";
+import {
+  type AccessGrants,
+  type ActionKey,
+  CAPABILITIES,
+  type Capability,
+  type LevelPageId,
+  type PageGrants,
+  can,
+  capabilitiesForLevel,
+  capabilitiesFromGrants,
+  grantsFromCapabilities,
+  isActionKey,
+  isLevelPageId,
+  levelCapabilities,
+} from "@/lib/permissions";
+import { PAGES } from "@/lib/routes";
+import { storedOneOf } from "@/lib/row-parse";
+
+export type ActionResult = { ok: true } | { ok: false; error: string };
+
+export interface AppUserRow extends AccessGrants {
+  email: string;
+  role: string;
+  status: string;
+  invitedBy: string | null;
+}
+
+export interface AccessSnapshot extends AccessGrants {
+  email: string;
+}
+
+interface InviteResult {
+  invited: string[];
+  skipped: { email: string; reason: string }[];
+}
+
+const SELF_LOCKOUT: ActionResult = {
+  ok: false,
+  error: "You can't remove your own user-management permission",
+};
+
+const pageId = z.custom<LevelPageId>((value) => typeof value === "string" && isLevelPageId(value));
+const actionKey = z.custom<ActionKey>((value) => typeof value === "string" && isActionKey(value));
+
+const changeSchema = z.discriminatedUnion("kind", [
+  z.object({
+    kind: z.literal("page"),
+    page: pageId,
+    level: z.enum(["none", "read", "write"]),
+  }),
+  z.object({ kind: z.literal("action"), action: actionKey, granted: z.boolean() }),
+]);
+
+const snapshotSchema = z.object({
+  email: z.string(),
+  pages: z.record(pageId, z.enum(["read", "write"])),
+  actions: z.array(actionKey),
+});
+
+async function authorize() {
+  try {
+    return await requireCapability("users.manage");
+  } catch (err) {
+    if (err instanceof AuthzError) return null;
+    throw err;
+  }
+}
+
+function normalize(emails: readonly string[]): string[] {
+  return [...new Set(emails.map((e) => e.trim().toLowerCase()).filter(Boolean))];
+}
+
+function revalidate() {
+  revalidatePath(PAGES["settings.access"].path);
+}
+
+async function memberEmails(candidates: readonly string[]): Promise<string[]> {
+  if (candidates.length === 0) return [];
+  const rows = await getDb()
+    .select({ email: schema.appUsers.email })
+    .from(schema.appUsers)
+    .where(and(inArray(schema.appUsers.email, [...candidates]), ne(schema.appUsers.role, "admin")));
+  return rows.map((r) => r.email);
+}
+
+export const inviteUsers = serverAction(
+  z.tuple([z.array(z.string())]),
+  async (emailsRaw): Promise<ActionResult & { result?: InviteResult }> => {
+    const me = await authorize();
+    if (!me) return { ok: false, error: "Not authorized" };
+
+    const emails = normalize(emailsRaw);
+    if (emails.length === 0) return { ok: false, error: "Enter at least one email address" };
+    const valid = emails.filter((e) => EMAIL_PATTERN.test(e));
+
+    const inserted =
+      valid.length === 0
+        ? []
+        : await getDb()
+            .insert(schema.appUsers)
+            .values(
+              valid.map((email) => ({
+                email,
+                role: "member",
+                status: "invited",
+                invitedBy: me.email ?? null,
+              }))
+            )
+            .onConflictDoNothing()
+            .returning({ email: schema.appUsers.email });
+    const invited = inserted.map((r) => r.email);
+
+    revalidate();
+    return {
+      ok: true,
+      result: {
+        invited,
+        skipped: [
+          ...emails
+            .filter((e) => !EMAIL_PATTERN.test(e))
+            .map((email) => ({ email, reason: "Not a valid email address" })),
+          ...valid
+            .filter((e) => !invited.includes(e))
+            .map((email) => ({ email, reason: "Already on the list" })),
+        ],
+      },
+    };
+  }
+);
+
+export const revokeUsers = serverAction(
+  z.tuple([z.array(z.string())]),
+  async (emailsRaw): Promise<ActionResult> => {
+    const me = await authorize();
+    if (!me) return { ok: false, error: "Not authorized" };
+    const emails = normalize(emailsRaw);
+    if (emails.includes(me.email?.toLowerCase() ?? "")) {
+      return { ok: false, error: "You can't remove your own access" };
+    }
+    const targets = me.role === "admin" ? emails : await memberEmails(emails);
+    if (targets.length === 0) return { ok: true };
+
+    await getDb().transaction(async (tx) => {
+      await tx.delete(schema.appUsers).where(inArray(schema.appUsers.email, targets));
+      await tx
+        .delete(schema.capabilityGrants)
+        .where(inArray(schema.capabilityGrants.email, targets));
+    });
+    revalidate();
+    return { ok: true };
+  }
+);
+
+export async function listAppUsers(): Promise<AppUserRow[]> {
+  const me = await getAppUser();
+  if (!me || !can(me, "users.manage")) return [];
+
+  const db = getDb();
+  const [users, grantRows] = await Promise.all([
+    db
+      .select({
+        email: schema.appUsers.email,
+        role: schema.appUsers.role,
+        status: schema.appUsers.status,
+        invitedBy: schema.appUsers.invitedBy,
+      })
+      .from(schema.appUsers)
+      .orderBy(schema.appUsers.email),
+    db.select().from(schema.capabilityGrants),
+  ]);
+
+  const heldBy = new Map<string, Capability[]>();
+  for (const row of grantRows) {
+    const held = heldBy.get(row.email) ?? [];
+    held.push(storedOneOf(row.capability, CAPABILITIES, "capability_grants.capability"));
+    heldBy.set(row.email, held);
+  }
+  return users.map((user) => ({
+    ...user,
+    ...grantsFromCapabilities(heldBy.get(user.email) ?? []),
+  }));
+}
+
+function replaceRows(
+  emails: readonly string[],
+  capabilities: readonly Capability[],
+  by: string | null
+) {
+  return capabilities.flatMap((capability) =>
+    emails.map((email) => ({ email, capability, grantedBy: by }))
+  );
+}
+
+export const applyAccessChanges = serverAction(
+  z.tuple([z.array(z.string()), z.array(changeSchema)]),
+  async (emailsRaw, changes: AccessChange[]): Promise<ActionResult> => {
+    const me = await authorize();
+    if (!me) return { ok: false, error: "Not authorized" };
+    if (!changes.every(isAllowedChange)) return { ok: false, error: "Unknown permission" };
+
+    const targets = await memberEmails(normalize(emailsRaw));
+    if (targets.length === 0) return { ok: true };
+
+    const levels = new Map<LevelPageId, AccessChange>();
+    const actions = new Map<ActionKey, boolean>();
+    for (const change of changes) {
+      if (change.kind === "page") levels.set(change.page, change);
+      else actions.set(change.action, change.granted);
+    }
+    if (actions.get("users.manage") === false && targets.includes(me.email?.toLowerCase() ?? "")) {
+      return SELF_LOCKOUT;
+    }
+
+    const removed = [
+      ...[...levels.keys()].flatMap(levelCapabilities),
+      ...[...actions].filter(([, granted]) => !granted).map(([action]) => action),
+    ];
+    const added = [
+      ...[...levels.values()].flatMap((change) =>
+        change.kind === "page" ? capabilitiesForLevel(change.page, change.level) : []
+      ),
+      ...[...actions].filter(([, granted]) => granted).map(([action]) => action),
+    ];
+
+    await getDb().transaction(async (tx) => {
+      if (removed.length > 0) {
+        await tx
+          .delete(schema.capabilityGrants)
+          .where(
+            and(
+              inArray(schema.capabilityGrants.email, targets),
+              inArray(schema.capabilityGrants.capability, removed)
+            )
+          );
+      }
+      if (added.length > 0) {
+        await tx
+          .insert(schema.capabilityGrants)
+          .values(replaceRows(targets, added, me.email ?? null))
+          .onConflictDoNothing();
+      }
+    });
+    revalidate();
+    return { ok: true };
+  }
+);
+
+async function replaceAccess(
+  targets: readonly string[],
+  capabilitiesFor: (email: string) => Capability[],
+  by: string | null
+) {
+  const values = targets.flatMap((email) =>
+    capabilitiesFor(email).map((capability) => ({ email, capability, grantedBy: by }))
+  );
+  await getDb().transaction(async (tx) => {
+    await tx
+      .delete(schema.capabilityGrants)
+      .where(inArray(schema.capabilityGrants.email, [...targets]));
+    if (values.length > 0) await tx.insert(schema.capabilityGrants).values(values);
+  });
+}
+
+export const copyAccess = serverAction(
+  z.tuple([z.string(), z.array(z.string())]),
+  async (fromEmail, toEmailsRaw): Promise<ActionResult> => {
+    const me = await authorize();
+    if (!me) return { ok: false, error: "Not authorized" };
+
+    const from = fromEmail.trim().toLowerCase();
+    const db = getDb();
+    const [source] = await db
+      .select({ role: schema.appUsers.role })
+      .from(schema.appUsers)
+      .where(eq(schema.appUsers.email, from))
+      .limit(1);
+    if (!source) return { ok: false, error: "Unknown user to copy from" };
+    if (source.role === "admin") {
+      return { ok: false, error: "Admins have full access; nothing to copy" };
+    }
+
+    const targets = (await memberEmails(normalize(toEmailsRaw))).filter((e) => e !== from);
+    if (targets.length === 0) return { ok: true };
+
+    const rows = await db
+      .select({ capability: schema.capabilityGrants.capability })
+      .from(schema.capabilityGrants)
+      .where(eq(schema.capabilityGrants.email, from));
+    const capabilities = rows.map((row) =>
+      storedOneOf(row.capability, CAPABILITIES, "capability_grants.capability")
+    );
+    if (targets.includes(me.email?.toLowerCase() ?? "") && !capabilities.includes("users.manage")) {
+      return SELF_LOCKOUT;
+    }
+
+    await replaceAccess(targets, () => capabilities, me.email ?? null);
+    revalidate();
+    return { ok: true };
+  }
+);
+
+function snapshotCapabilities(snapshot: AccessSnapshot | undefined): Capability[] {
+  if (snapshot === undefined) return [];
+  const pages: PageGrants = snapshot.pages;
+  return capabilitiesFromGrants({ pages, actions: snapshot.actions });
+}
+
+export const restoreAccess = serverAction(
+  z.tuple([z.array(snapshotSchema)]),
+  async (snapshots): Promise<ActionResult> => {
+    const me = await authorize();
+    if (!me) return { ok: false, error: "Not authorized" };
+
+    const byEmail = new Map(snapshots.map((s) => [s.email.trim().toLowerCase(), s]));
+    const targets = await memberEmails([...byEmail.keys()]);
+    if (targets.length === 0) return { ok: true };
+
+    const myEmail = me.email?.toLowerCase() ?? "";
+    if (
+      targets.includes(myEmail) &&
+      !snapshotCapabilities(byEmail.get(myEmail)).includes("users.manage")
+    ) {
+      return SELF_LOCKOUT;
+    }
+
+    await replaceAccess(
+      targets,
+      (email) => snapshotCapabilities(byEmail.get(email)),
+      me.email ?? null
+    );
+    revalidate();
+    return { ok: true };
+  }
+);
