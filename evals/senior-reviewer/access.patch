@@ -0,0 +1,95 @@
+"use client";
+
+import { useState } from "react";
+
+import { parseInviteList } from "@/lib/access-model";
+
+export function InvitePanel({
+  known,
+  busy,
+  onInvite,
+  onClose,
+}: {
+  known: readonly string[];
+  busy: boolean;
+  onInvite: (emails: string[]) => Promise<boolean>;
+  onClose: () => void;
+}) {
+  const [text, setText] = useState("");
+  const parsed = parseInviteList(text, known);
+
+  async function submit() {
+    if (parsed.valid.length === 0) return;
+    if (await onInvite(parsed.valid)) setText("");
+  }
+
+  return (
+    <section className="space-y-2 rounded-lg border border-blue-200 bg-blue-50/50 p-3 dark:border-blue-900 dark:bg-blue-950/20">
+      <div className="flex items-center justify-between">
+        <h2 className="text-sm font-semibold text-slate-900 dark:text-slate-100">Invite people</h2>
+        <button
+          type="button"
+          onClick={onClose}
+          aria-label="Close invite panel"
+          className="rounded px-1.5 text-lg leading-none text-slate-400 hover:text-slate-700"
+        >
+          ×
+        </button>
+      </div>
+      <textarea
+        value={text}
+        onChange={(e) => setText(e.target.value)}
+        rows={3}
+        aria-label="Emails to invite"
+        placeholder="Paste emails separated by commas, spaces or new lines"
+        className="w-full resize-y rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-700 dark:bg-slate-900"
+        suppressHydrationWarning
+      />
+      {(parsed.valid.length > 0 || parsed.invalid.length > 0 || parsed.existing.length > 0) && (
+        <ul className="flex flex-wrap gap-1.5">
+          {parsed.valid.map((email) => (
+            <li
+              key={email}
+              className="rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300"
+            >
+              {email}
+            </li>
+          ))}
+          {parsed.existing.map((email) => (
+            <li
+              key={email}
+              title="Already on the list"
+              className="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-500 line-through dark:bg-slate-800"
+            >
+              {email}
+            </li>
+          ))}
+          {parsed.invalid.map((token) => (
+            <li
+              key={token}
+              title="Not a valid email address"
+              className="rounded-full bg-red-100 px-2 py-0.5 text-[11px] text-red-700 dark:bg-red-950 dark:text-red-300"
+            >
+              {token}
+            </li>
+          ))}
+        </ul>
+      )}
+      <div className="flex items-center justify-between gap-3">
+        <p className="text-[11px] text-slate-500">
+          They sign in with Google using the same email. Newly invited people have no access until
+          you give them some.
+        </p>
+        <button
+          type="button"
+          onClick={() => void submit()}
+          disabled={busy || parsed.valid.length === 0}
+          className="shrink-0 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50"
+          suppressHydrationWarning
+        >
+          {parsed.valid.length > 1 ? `Invite ${parsed.valid.length} people` : "Invite"}
+        </button>
+      </div>
+    </section>
+  );
+}
