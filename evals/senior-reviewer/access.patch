+export function visiblePages(user: CapabilitySubject, group: PermissionGroup): AccessPageId[] {
+  return ACCESS_PAGES.filter((page) => groupOf(page) === group && canSeePage(user, page));
+}
+
+export function entryPath(user: CapabilitySubject, group: PermissionGroup): string | null {
+  const page = visiblePages(user, group)[0];
+  return page === undefined ? null : PAGES[page].path;
+}
+
+export function landingPath(user: CapabilitySubject): string | null {
+  for (const { key } of GROUPS) {
+    const path = entryPath(user, key);
+    if (path !== null) return path;
+  }
+  return null;
+}
+
+export type PageGrants = Partial<Record<LevelPageId, "read" | "write">>;
+
+export interface AccessGrants {
+  pages: PageGrants;
+  actions: ActionKey[];
+}
+
+export function grantsFromCapabilities(capabilities: Iterable<Capability>): AccessGrants {
+  const held = new Set(capabilities);
+  const pages: PageGrants = {};
+  for (const page of LEVEL_PAGES) {
+    if (isWritablePage(page) && held.has(`${page}:write`)) pages[page] = "write";
+    else if (held.has(`${page}:read`)) pages[page] = "read";
+  }
+  return { pages, actions: ACTION_KEYS.filter((action) => held.has(action)) };
+}
+
+export function capabilitiesForLevel(page: LevelPageId, level: PageLevel): Capability[] {
+  if (level === "none") return [];
+  return level === "write" && isWritablePage(page) ? [`${page}:write`] : [`${page}:read`];
+}
+
+export function levelCapabilities(page: LevelPageId): Capability[] {
+  return isWritablePage(page) ? [`${page}:read`, `${page}:write`] : [`${page}:read`];
+}
+
+export function isLevelPageId(value: string): value is LevelPageId {
+  return isAccessPage(value) && isLevelPage(value);
+}
+
+export function isActionKey(value: string): value is ActionKey {
+  return ACTION_KEYS.some((action) => action === value);
+}
+
+export function capabilitiesFromGrants(grants: AccessGrants): Capability[] {
+  const pages = LEVEL_PAGES.flatMap((page) =>
+    capabilitiesForLevel(page, grants.pages[page] ?? "none")
+  );
+  return [...pages, ...grants.actions];
+}
+
+export function grantLevel(pages: PageGrants, page: AccessPageId): PageLevel {
+  return isLevelPage(page) ? (pages[page] ?? "none") : "none";
