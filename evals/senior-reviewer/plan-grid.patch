index 00000000..aae1ed4d
--- /dev/null
+++ b/apps/web/src/lib/demand-plan-grid.integration.test.ts
@@ -0,0 +1,93 @@
+import { randomUUID } from "node:crypto";
+
+import { getDb, getSql, schema } from "@hj/db";
+import { inArray } from "drizzle-orm";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+
+import { getPlanGridData } from "@/lib/demand-plan-grid";
+import { syncRoughDemand } from "@/lib/dev-items/rough-demand";
+import { currentMonthIso } from "@/lib/forecast/dates";
+
+const enabled = process.env.DEMAND_PLAN_GRID_DB_TEST === "1";
+const planWrite = {
+  loadChannelMeta: async () => ({ discountMultiplier: new Map<string, number>() }),
+};
+const suffix = randomUUID().slice(0, 8);
+const checkedUpc = `DEV-T${suffix}A`;
+const uncheckedUpc = `DEV-T${suffix}B`;
+const channel = "Grid Test Channel";
+const month = currentMonthIso();
+
+function devItem(upc: string, inDemandPlan: boolean) {
+  return {
+    upc,
+    nsInternalId: `test-${upc}`,
+    name: `Grid test ${upc}`,
+    division: "hydrojug",
+    productType: "Tumbler",
+    color: "Test Teal",
+    releaseName: "Grid Test Release",
+    productSpecification: "Straw Lid",
+    status: "Developing",
+    roughSaleschannel: channel,
+    roughQuantity: 900,
+    roughStartMonth: month,
+    roughEndMonth: month,
+    launchDate: null,
+    dockDate: null,
+    endDate: null,
+    inDemandPlan,
+  };
+}
+
+let localVerified = false;
+describe.skipIf(!enabled)("demand plan grid against Postgres", () => {
+  beforeAll(async () => {
+    const url = new URL(process.env.DATABASE_URL ?? "http://missing");
+    if (!["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)) {
+      throw new Error("Demand plan grid DB tests require localhost");
+    }
+    localVerified = true;
+    const rows = [devItem(checkedUpc, true), devItem(uncheckedUpc, false)];
+    await getDb().insert(schema.supplyDevItems).values(rows);
+    const failed = await syncRoughDemand(rows, new Map(), planWrite);
+    if (failed.length > 0) throw new Error(`rough demand did not write for ${failed.join(", ")}`);
+  });
+  afterAll(async () => {
+    if (!localVerified) return;
+    const db = getDb();
+    const upcs = [checkedUpc, uncheckedUpc];
+    await db.delete(schema.supplyPlanMonthly).where(inArray(schema.supplyPlanMonthly.upc, upcs));
+    await db.delete(schema.supplyDemandPlan).where(inArray(schema.supplyDemandPlan.upc, upcs));
+    await db
+      .delete(schema.variantForecastMethods)
+      .where(inArray(schema.variantForecastMethods.upc, upcs));
+    await db.delete(schema.supplyDevItems).where(inArray(schema.supplyDevItems.upc, upcs));
+    await getSql().end();
+  });
+
+  it("lists a placeholder checked for the demand plan, with its own attributes and units", async () => {
+    const { rows } = await getPlanGridData("hydrojug", "demand", "month");
+    const row = rows.find((r) => r.upc === checkedUpc);
+    expect(row).toMatchObject({
+      sales_channel: channel,
+      product_type: "Tumbler",
+      color: "Test Teal",
+      spec: "Straw Lid",
+      release_name: "Grid Test Release",
+      life_status: "Developing",
+    });
+    expect(row?.[`q_${month.slice(0, 7)}`]).toBe(900);
+  });
+
+  it("omits a placeholder that is not checked for the demand plan", async () => {
+    const { rows } = await getPlanGridData("hydrojug", "demand", "month");
+    expect(rows.filter((r) => r.upc === uncheckedUpc)).toEqual([]);
+  });
+
+  it("lists the checked placeholder in the weekly grid too", async () => {
+    const { rows } = await getPlanGridData("hydrojug", "demand", "week");
+    expect(rows.some((r) => r.upc === checkedUpc)).toBe(true);
+    expect(rows.some((r) => r.upc === uncheckedUpc)).toBe(false);
+  });
+});
