{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "outputStyle": "STE Visual",
  "tui": "fullscreen",
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 250000,
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/bin/kolin-skills' pull --quiet",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/compact-context.py' after",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/bin/context-audit' --notice",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 '{{REPO}}/bin/kolin-skills' stacks --stop --idle-hours 2 1>&2",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "nohup python3 '{{REPO}}/bin/disk-cleanup' --only worktrees --only supabase-stacks --only build-caches --worktree-owner claude --stale-days 3 --apply --once-a-day >/dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__t3-code__pull_request_merge",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/gate/git_guard.py' hook"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/block-env-reads.py'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task|mcp__t3-code__delegate_task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/agent-default-model.py'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/subagent-turn-guard.py'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|mcp__t3-code__pull_request_merge",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/bash-guard.py'",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "mcp__t3-code__preview_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/preview-budget.py'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/lint-changed-lines.py'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|mcp__t3-code__pull_request_create|mcp__t3-code__pull_request_update",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/pr-proof.py'",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/keep-awake.py'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{REPO}}/hooks/compact-context.py' before",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:deep-research": "user-invocable-only",
    "claude-approvals": "user-invocable-only",
    "find-skills": "user-invocable-only",
    "full-send": "user-invocable-only",
    "hydrojug-untangle": "user-invocable-only",
    "schedule": "user-invocable-only",
    "workflow-authoring": "user-invocable-only",
    "dataviz": "name-only",
    "anthropic-skills:computer-use": "name-only",
    "reverse-engineer-anything": "user-invocable-only",
    "agent-browser": "user-invocable-only",
    "agent-desktop": "user-invocable-only",
    "repo-standard": "user-invocable-only",
    "user-notes": "user-invocable-only",
    "explainer": "user-invocable-only",
    "council": "user-invocable-only"
  }
}
