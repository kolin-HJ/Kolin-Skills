#!/usr/bin/env python3
import argparse
import dataclasses
import importlib.machinery
import importlib.util
import os
import pathlib
import sys

KINDS = ("code", "tests", "docs")
OTHER = "Other"

HEAD = (
    "<What changes for the person who uses it, and why. Two sentences at most.>\n\n"
    "**Risk:** <Low. Or what could break, any deploy order, and how to undo it.>\n\n"
    "## Changes\n\n"
)
TAIL = (
    "## Check these\n\n"
    "- [ ] `<file:line>`: <a question only a person can answer. Delete the section if none.>\n\n"
    "## Cleanup\n\n"
    "- `<file:line>`: <what you simplified, or what you left and why. Delete the section if none.>\n\n"
    "## Verification\n\n"
    "- Ran: `<command>`, <result in a few words>\n"
    "- Not run: <check>, because <why>\n"
)


@dataclasses.dataclass(frozen=True)
class FileChange:
    path: str
    added: int
    removed: int
    kind: str
    lock: bool
    binary: bool


@dataclasses.dataclass(frozen=True)
class Feature:
    name: str
    files: tuple


def load_audit():
    path = str(pathlib.Path(__file__).resolve().with_name("diff-audit"))
    loader = importlib.machinery.SourceFileLoader("diff_audit", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("diff_audit", loader))
    loader.exec_module(module)
    return module


def kind_of(path, audit):
    if audit.TEST.search(path):
        return "tests"
    if audit.DOC.search(path):
        return "docs"
    return "code"


def changes(base, audit):
    files = []
    for record in audit.git("diff", "--numstat", "-z", "--no-renames", base, "HEAD").split("\0"):
        if not record:
            continue
        added, removed, path = record.split("\t", 2)
        binary = added == "-"
        files.append(FileChange(path, 0 if binary else int(added), 0 if binary else int(removed),
                                kind_of(path, audit), bool(audit.LOCK.search(path)), binary))
    return files


def feature_arg(text):
    name, separator, paths = text.partition("=")
    patterns = tuple(p.strip() for p in paths.split(",") if p.strip())
    if not separator or not name.strip() or not patterns:
        raise argparse.ArgumentTypeError(f"expected NAME=PATH[,PATH...], got {text!r}")
    return name.strip(), patterns


def matches(path, pattern):
    return path == pattern or (pattern.endswith("/") and path.startswith(pattern))


def assign(files, declared, fail):
    names = [name for name, _ in declared]
    if OTHER in names:
        fail(f"{OTHER!r} is reserved for files no feature names")
    for name in names:
        if names.count(name) > 1:
            fail(f"feature {name!r} is declared twice")
    owner = {}
    for name, patterns in declared:
        for pattern in patterns:
            matched = [f for f in files if matches(f.path, pattern)]
            if not matched:
                fail(f"feature {name!r}: {pattern!r} matches no changed file (a folder needs a trailing /)")
            for f in matched:
                if owner.setdefault(f.path, name) != name:
                    fail(f"{f.path} is in both {owner[f.path]!r} and {name!r}")
    features = [Feature(name, tuple(f for f in files if owner.get(f.path) == name)) for name in names]
    rest = tuple(f for f in files if f.path not in owner)
    return features + ([Feature(OTHER, rest)] if rest else [])


def files_label(n):
    return f"{n} file{'' if n == 1 else 's'}"


def delta(files):
    counted = [f for f in files if not f.lock and not f.binary]
    return f"+{sum(f.added for f in counted)} -{sum(f.removed for f in counted)}"


def test_ratio(files):
    added = {kind: sum(f.added for f in files if f.kind == kind and not f.lock and not f.binary) for kind in KINDS}
    return f" · {added['tests'] / added['code']:.1f} test lines per code line" if added["code"] and added["tests"] else ""


def stats(files):
    parts = [files_label(len(files))]
    for kind in KINDS:
        counted = [f for f in files if f.kind == kind and not f.lock and not f.binary]
        if counted:
            parts.append(f"{kind} {delta(counted)}")
    return " · ".join(parts)


def render(features):
    files = [f for feature in features for f in feature.files]
    total = f"`{files_label(len(files))} · {delta(files)}{test_ratio(files)}`\n\n"
    summary = "".join(f"- **{feature.name}:** <what now behaves differently> `{stats(feature.files)}`\n"
                      for feature in features)
    return HEAD + total + summary + "\n" + TAIL


def main():
    parser = argparse.ArgumentParser(
        description="Print a short PR body skeleton with one line per feature and the diff size.")
    parser.add_argument("base", nargs="?", default="origin/HEAD")
    parser.add_argument("--feature", action="append", required=True, type=feature_arg, metavar="NAME=PATH[,PATH...]",
                        help="Name a feature and its files, once per feature. A PATH ending in / takes the whole folder. "
                             f"Files no feature names go under {OTHER}.")
    args = parser.parse_args()
    audit = load_audit()
    os.chdir(audit.git("rev-parse", "--show-toplevel").strip())
    base = audit.git("merge-base", args.base, "HEAD").strip()
    files = changes(base, audit)
    if not files:
        parser.error(f"no changes between {args.base} and HEAD")
    sys.stdout.write(render(assign(files, args.feature, parser.error)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
