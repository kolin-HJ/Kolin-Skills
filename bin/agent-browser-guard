#!/usr/bin/env -S python3 -I
import os
import pathlib
import re
import shutil
import sys

EVIDENCE = pathlib.Path.home() / ".agent-browser-evidence"
NAMESPACE = "codex-guard"
ALLOWED_COMMANDS = {
    "open", "goto", "navigate", "read", "click", "dblclick", "type", "fill", "press", "key", "keyboard", "hover",
    "focus", "check", "uncheck", "select", "drag", "upload", "download", "scroll", "scrollintoview", "scrollinto",
    "wait", "screenshot", "pdf", "snapshot", "eval", "close", "quit", "exit", "back", "forward", "reload", "get",
    "is", "find", "mouse", "set", "network", "cookies", "storage", "tab", "frame", "dialog", "diff", "trace",
    "profiler", "record", "console", "errors", "highlight", "state", "session", "vitals", "a11y", "react",
    "pushstate", "removeinitscript", "webmcp", "skills", "confirm", "deny",
}
DENIED_FLAGS = {"--args", "--auto-connect", "--ca-cert", "--cdp", "--config", "--engine", "--executable-path",
                "--extension", "--model", "--namespace", "--profile", "--provider", "-p", "--restore",
                "--restore-save", "--session-name"}
GLOBAL_READ_FLAGS = {"--state", "--init-script", "--action-policy"}
SUBCOMMAND_READ_FLAGS = {("diff", "screenshot"): {"--baseline"}, ("cookies", "set"): {"--curl"}}
SESSION_NAME = re.compile(r"[A-Za-z0-9_-]{1,64}")
KEPT_ENV = {"AGENT_BROWSER_SESSION", "AGENT_BROWSER_DEFAULT_TIMEOUT"}


def evidence_problem():
    EVIDENCE.mkdir(mode=0o700, exist_ok=True)
    if EVIDENCE.is_symlink() or not EVIDENCE.is_dir() or EVIDENCE.stat().st_uid != os.getuid():
        return f"{EVIDENCE} must be a real directory you own"
    return None


def session_problem(args, env):
    names = [env["AGENT_BROWSER_SESSION"]] if "AGENT_BROWSER_SESSION" in env else []
    for index, arg in enumerate(args):
        if arg == "--session":
            names.append(args[index + 1] if index + 1 < len(args) else "")
        elif arg.startswith("--session="):
            names.append(arg.partition("=")[2])
    bad = [name for name in names if not SESSION_NAME.fullmatch(name)]
    return f"session name {bad[0]!r} must be 1 to 64 letters, digits, - or _" if bad else None


def split_command(args):
    index = 0
    while index < len(args) and args[index].startswith("-"):
        if args[index] == "--session" and index + 1 < len(args):
            index += 2
        elif args[index].startswith("--session=") or args[index] == "--json":
            index += 1
        else:
            return None, f"{args[index]}: before the command only --session <name> and --json are allowed"
    if index == len(args):
        return None, "no command given"
    if args[index] not in ALLOWED_COMMANDS:
        return None, f"{args[index]} is not an allowed command; allowed: {', '.join(sorted(ALLOWED_COMMANDS))}"
    return index, None


def read_flags(args, command):
    return GLOBAL_READ_FLAGS | SUBCOMMAND_READ_FLAGS.get(tuple(args[command:command + 2]), set())


def read_positions(args, command):
    name = args[command]
    rest = range(command + 1, len(args))
    flags = read_flags(args, command)
    positions = {index for index in rest if args[index - 1] in flags}
    if name == "upload":
        positions |= {index for index in rest if index >= command + 2
                      and not args[index].startswith("-") and not args[index - 1].startswith("-")}
    if name == "state" and args[command + 1:command + 2] == ["load"]:
        positions.add(command + 2)
    return positions


def looks_like_path(value, root):
    parts = value.split("/")
    first = root / parts[0]
    return value.startswith(("/", "~")) or ".." in parts or first.exists() or first.is_symlink()


def path_problem(value, readable, root):
    resolved = (root / pathlib.Path(value).expanduser()).resolve()
    if resolved.is_relative_to(root) or (readable and resolved.is_file()):
        return None
    return f"{value}: write paths must be inside {EVIDENCE}; outside it, only the files of upload, state load, diff screenshot --baseline, cookies set --curl and {', '.join(sorted(GLOBAL_READ_FLAGS))} may be read"


def refusal(args, root, env):
    command, problem = split_command(args)
    problem = problem or session_problem(args, env)
    if problem:
        return problem
    reads = read_positions(args, command)
    flags = read_flags(args, command)
    for index in range(command + 1, len(args)):
        arg = args[index]
        name, _, inline = arg.partition("=")
        if name in DENIED_FLAGS:
            return f"{name} can run a program, reach another browser session or reuse your logins outside the sandbox"
        value, readable = (inline, name in flags) if arg.startswith("-") else (arg, index in reads)
        if value and looks_like_path(value, root):
            problem = path_problem(value, readable, root)
            if problem:
                return problem
    return None


def main(args):
    root = EVIDENCE.resolve()
    problem = evidence_problem() or refusal(args, root, os.environ)
    if problem:
        print(f"agent-browser-guard: refused: {problem}", file=sys.stderr)
        return 2
    binary = shutil.which("agent-browser")
    if binary is None:
        print("agent-browser-guard: agent-browser is not on PATH; run kolin-skills upstream", file=sys.stderr)
        return 127
    env = {key: value for key, value in os.environ.items() if not key.startswith("AGENT_BROWSER_") or key in KEPT_ENV}
    os.chdir(root)
    os.execve(binary, [binary, "--namespace", NAMESPACE, *args], env)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
