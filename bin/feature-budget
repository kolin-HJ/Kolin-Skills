#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

KINDS = {"read": (5, 800), "edit": (7, 1200), "write": (12, 2500)}
SKIP = {".git", "node_modules", "dist", ".next", "__pycache__", ".venv", "coverage", "vendor"}
SOURCE = {".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py", ".go", ".rs"}
TEST = re.compile(r"(\.test\.|\.spec\.|(^|/)tests?/|_test\.(py|go)$|(^|/)test_[^/]+\.py$)")
SPEC = re.compile(r"""(?:from|import|require)\s*\(?\s*['"]([^'"]+)['"]""")
EXTENSIONS = [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py"]
INDEXES = ["index.ts", "index.tsx", "index.js", "index.py"]
PLAN = pathlib.Path(".pstack/feature-budgets.json")
HEADER = ("feature-budget: {n} features (report-only). "
          "Over budget fails review; over 2x stops the wave (repo-standard, Layout)")
REVIEW = "over — fails review"
WAVE = "2x — wave stops until Kolin approves a new budget (repo-standard, Layout)"
GREW = ("FAIL: {name} is over twice its budget and this change adds {net} lines against {base}. "
        "Cut the feature back, or raise its budget in {plan} for Kolin to approve (repo-standard, Layout).")


def relative(path, root):
    return path.resolve().relative_to(root.resolve()).as_posix()


def lines_of(path):
    return len(path.read_text(encoding="utf-8", errors="ignore").splitlines())


def walk(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [name for name in dirnames if name not in SKIP]
        for name in filenames:
            path = pathlib.Path(dirpath) / name
            if path.suffix in SOURCE:
                yield path


def feature_folder(rel, owned):
    for name, paths in owned:
        if any(rel == path or rel.startswith(path + "/") for path in paths):
            return name, name
    parts = pathlib.PurePosixPath(rel).parts
    if "features" not in parts:
        return None, None
    i = parts.index("features")
    if i + 1 >= len(parts):
        return None, None
    return str(pathlib.PurePosixPath(*parts[: i + 2])), parts[i + 1]


def resolve(importer, spec, files):
    if not spec.startswith("."):
        return None
    base = importer.parent
    for part in spec.split("/"):
        if part == "..":
            base = base.parent
        elif part not in (".", ""):
            base = base / part
    candidates = [base, *(base.with_suffix(ext) for ext in EXTENSIONS),
                  *(base / name for name in INDEXES)]
    for candidate in candidates:
        resolved = candidate.resolve()
        if resolved in files:
            return resolved
    return None


def package_name(spec):
    parts = spec.split("/")
    if spec.startswith("@") and len(parts) > 1:
        return parts[1]
    return parts[0]


def is_wrapper(path, specs):
    relative_specs = [item for item in specs if item.startswith(".")]
    third = [item for item in specs if not item.startswith((".", "/"))]
    names = {package_name(item) for item in third}
    if relative_specs or len(names) != 1:
        return False
    pkg = next(iter(names)).lower().replace("_", "-")
    stem = path.stem.lower().replace("_", "-")
    return pkg in stem or stem in pkg


def load_plan(path):
    if not path.is_file():
        return {}, KINDS
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        sys.exit(f"feature-budget: {path} is not valid JSON ({error}). Fix the file; a broken plan never falls back to defaults.")
    defaults = {kind: (int(size["files"]), int(size["lines"])) for kind, size in data.get("defaults", {}).items()}
    return data.get("features", {}), {**KINDS, **defaults}


def owned_paths(plan):
    return [(name, [path.strip("/") for path in entry["paths"]])
            for name, entry in plan.items() if entry.get("paths")]


def net_growth(root, base, owned):
    diff = subprocess.run(["git", "-C", str(root), "diff", "--relative", "--numstat", "--no-renames", "-z",
                           f"{base}...HEAD"], text=True, capture_output=True)
    if diff.returncode:
        sys.exit(f"feature-budget: cannot diff against {base}: {diff.stderr.strip()}")
    net = {}
    for row in filter(None, diff.stdout.split("\0")):
        added, deleted, rel = row.split("\t", 2)
        if added == "-" or pathlib.PurePosixPath(rel).suffix not in SOURCE or TEST.search(rel):
            continue
        folder, _ = feature_folder(rel, owned)
        if folder is not None:
            net[folder] = net.get(folder, 0) + int(added) - int(deleted)
    return net


def budget(name, plan, kinds):
    entry = plan.get(name, {})
    if "files" in entry and "lines" in entry:
        return int(entry["files"]), int(entry["lines"]), "plan"
    kind = entry.get("kind", "read")
    if kind not in kinds:
        sys.exit(f"feature-budget: {name} has kind {kind!r}. Use one of {', '.join(sorted(kinds))}.")
    files, lines = kinds[kind]
    return files, lines, kind


def status(files, lines, budget_files, budget_lines):
    if files > 2 * budget_files or lines > 2 * budget_lines:
        return WAVE
    if files > budget_files or lines > budget_lines:
        return REVIEW
    return "ok"


def incoming(files):
    texts = {path: path.read_text(encoding="utf-8", errors="ignore") for path in files}
    specs_by = {path: SPEC.findall(texts[path]) for path in files}
    counts = {path: 0 for path in files}
    for importer, specs in specs_by.items():
        for spec in specs:
            target = resolve(importer, spec, files)
            if target is not None and target != importer:
                counts[target] += 1
    return counts, specs_by


def report(root, plan_path, base):
    root = pathlib.Path(root)
    files = {path.resolve() for path in walk(root)}
    plan, kinds = load_plan(plan_path)
    owned = owned_paths(plan)
    features = {}
    for path in files:
        rel = relative(path, root)
        folder, name = feature_folder(rel, owned)
        if folder is None or TEST.search(rel):
            continue
        features.setdefault(folder, {"name": name, "files": []})["files"].append(path)
    net = net_growth(root, base, owned) if base else {}
    counts, specs_by = incoming(files)
    rows = [HEADER.format(n=len(features))]
    failures = []
    for folder in sorted(features):
        item = features[folder]
        paths = item["files"]
        file_count = len(paths)
        line_count = sum(lines_of(path) for path in paths)
        budget_files, budget_lines, source = budget(item["name"], plan, kinds)
        state = status(file_count, line_count, budget_files, budget_lines)
        rows.append(
            f"{item['name']}  files={file_count} lines={line_count} "
            f"budget={budget_files}/{budget_lines} ({source})  {state}"
        )
        if state == WAVE and net.get(folder, 0) > 0:
            failures.append(GREW.format(name=item["name"], net=net[folder], base=base, plan=plan_path))
        for path in sorted(paths, key=lambda candidate: relative(candidate, root)):
            n = lines_of(path)
            if n >= 40 or counts.get(path, 0) != 1:
                continue
            if is_wrapper(path, specs_by.get(path, [])):
                continue
            rows.append(f"  fragment: {relative(path, root)} {n} lines, 1 importer")
    return "\n".join(rows) + "\n", failures


def main():
    parser = argparse.ArgumentParser(
        description="Report per-feature file and line counts against the plan budget. "
                    "A feature is a features/<name>/ folder, or a plan entry with paths. "
                    "Without --base it is report-only. With --base it fails when a feature over twice its budget "
                    "gained net source lines since that ref (repo-standard, Layout)."
    )
    parser.add_argument("root", nargs="?", default=".")
    parser.add_argument("--plan", help=f"plan file, default <root>/{PLAN}")
    parser.add_argument("--base", help="git ref to measure growth against, such as origin/staging")
    args = parser.parse_args()
    plan_path = pathlib.Path(args.plan) if args.plan else pathlib.Path(args.root) / PLAN
    text, failures = report(args.root, plan_path, args.base)
    sys.stdout.write(text)
    for failure in failures:
        print(failure, file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
