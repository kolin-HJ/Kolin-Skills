def render_template(text):
    return text.replace("{{HOME}}", str(HOME)).replace("{{REPO}}", str(REPO))


def wired_repo():
    state_file = STATE_DIR / "state.json"
    return json.loads(state_file.read_text())["repo"] if state_file.is_file() else None


def is_managed_hook(entry, roots):
    text = json.dumps(entry)
    return any(f"{root}/" in text for root in roots) or any(path in text for path in LEGACY_HOOK_PATHS)


def merge_hooks(current, wanted, roots):
    merged = {}
    for event in [*current, *(event for event in wanted if event not in current)]:
        entries = [entry for entry in current.get(event, []) if not is_managed_hook(entry, roots)]
        entries += wanted.get(event, [])
        if entries:
            merged[event] = entries
    return merged


def merge_settings(current, wanted, roots):
    merged = dict(current)
    for key, value in wanted.items():
        if key == "hooks":
            merged[key] = merge_hooks(current.get(key, {}), value, roots)
        elif isinstance(value, dict) and isinstance(current.get(key), dict):
            merged[key] = {**current[key], **value}
        else:
            merged[key] = value
    return merged


def codex_agent_toml(markdown):
    _, header, body = markdown.split("---\n", 2)
    fields = {}
    for line in header.splitlines():
        key, _, value = line.partition(":")
        fields[key.strip()] = value.strip()
    body = body.strip("\n")
    if "'''" in body:
        raise SystemExit(f"{fields['name']}: body contains ''', which a TOML literal string cannot hold")
    lines = [f"name = {json.dumps(fields['name'], ensure_ascii=False)}",
             f"description = {json.dumps(fields['description'], ensure_ascii=False)}"]
    tools = {tool.strip() for tool in fields.get("tools", "").split(",") if tool.strip()}
    if tools and not tools & WRITE_TOOLS:
        lines.append('sandbox_mode = "read-only"')
    lines.append(f"developer_instructions = '''\n{body}\n'''")
    return "\n".join(lines) + "\n"


class Plan:
    def __init__(self, check):
        self.check = check
        self.changes = []
        self.owned = set()
        self.stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")

    def note(self, message):
        self.changes.append(message)

    def backup(self, path):
        destination = STATE_DIR / "backup" / self.stamp / path.relative_to(HOME)
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(path), str(destination))

    def link(self, target, path):
        self.owned.add(path)
        if path.is_symlink() and os.readlink(path) == str(target):
            return
        self.note(f"link ~/{path.relative_to(HOME)} -> {target}")
        if self.check:
            return
        if path.is_symlink():
            path.unlink()
        elif path.exists():
            self.backup(path)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(target)

    def write(self, path, text):
        self.owned.add(path)
        if path.is_file() and not path.is_symlink() and path.read_text() == text:
            return
        self.note(f"write ~/{path.relative_to(HOME)}")
        if self.check:
            return
        if path.is_symlink():
            path.unlink()
        elif path.exists():
            self.backup(path)
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary = path.with_name(f".{path.name}.kolin-skills")
        temporary.write_text(text)
        temporary.replace(path)

    def write_json(self, path, data):
        current = json.loads(path.read_text()) if path.is_file() else None
        if current == data:
            return
        self.write(path, json.dumps(data, indent=2) + "\n")

    def retire(self, path):
        self.owned.add(path)
        self.note(f"retire ~/{path.relative_to(HOME)}")
        if self.check:
            return
        if path.is_symlink():
            path.unlink()
        else:
            self.backup(path)

    def remove(self, path):
        self.owned.add(path)
        self.note(f"remove ~/{path.relative_to(HOME)}")
        if not self.check:
            path.unlink()


def vendor_skills():
    skills = {}
    for directory, chosen in VENDOR_SKILL_DIRS.items():
        for skill in sorted((VENDOR / directory).glob("*/SKILL.md")):
            if skill.parent.name not in VENDOR_SKIP and (chosen is None or skill.parent.name in chosen):
                skills[skill.parent.name] = skill.parent
    return skills


def points_into_managed_tree(path, roots):
    text = os.readlink(path)
    return text.startswith((*(f"{root}/" for root in roots), str(VENDOR), "../../.agents/skills/"))


def prune_stale_links(plan, directory, roots):
    if not directory.is_dir():
        return
    for path in sorted(directory.iterdir()):
        if not path.is_symlink() or path in plan.owned or not points_into_managed_tree(path, roots):
            continue
        if not path.exists() or os.readlink(path).startswith(str(VENDOR)):
            plan.remove(path)


def apply(plan, roots):
    for source, destinations in LINKS.items():
        if (REPO / source).exists():
            for destination in destinations:
                plan.link(REPO / source, HOME / destination)

    own = sorted(path.parent for path in (REPO / "skills").glob("*/SKILL.md"))
    vendored = vendor_skills()
    for skill in own:
        plan.link(skill, HOME / ".agents/skills" / skill.name)
        for home in OWN_SKILL_HOMES[1:]:
            plan.link(pathlib.Path(f"../../.agents/skills/{skill.name}"), HOME / home / skill.name)
    for name, skill in vendored.items():
        if name in {path.name for path in own}:
            continue
        plan.link(skill, HOME / ".agents/skills" / name)
        for home in VENDOR_SKILL_HOMES[1:]:
            existing = HOME / home / name
            if existing.exists() and not existing.is_symlink():
                plan.owned.add(existing)
                continue
            plan.link(pathlib.Path(f"../../.agents/skills/{name}"), existing)

    for name in sorted(DROPPED_SKILLS - declared_upstream_skills()):
        for home in WATCHED_HOMES:
            path = HOME / home / name
            if path.is_symlink() or path.exists():
                plan.retire(path)

    own_agents = sorted((REPO / "agents").glob("*.md"))
    vendored_agents = [VENDOR / path for path in VENDOR_AGENTS if (VENDOR / path).is_file()]
    agents = own_agents + [agent for agent in vendored_agents if agent.name not in {own.name for own in own_agents}]
    for agent in agents:
        plan.link(agent, HOME / ".claude/agents" / agent.name)
        plan.write(HOME / ".codex/agents" / f"{agent.stem}.toml", codex_agent_toml(agent.read_text()))
    for home in WATCHED_HOMES:
        prune_stale_links(plan, HOME / home, roots)
    state_file = STATE_DIR / "state.json"
    generated = {str(HOME / ".codex/agents" / f"{agent.stem}.toml") for agent in agents}
    previous = set(json.loads(state_file.read_text())["generated"]) if state_file.is_file() else set()
    for stale in sorted(previous - generated):
        if pathlib.Path(stale).is_file():
            plan.remove(pathlib.Path(stale))

    for source, destination in MERGED_JSON.items():
        wanted = json.loads(render_template((REPO / source).read_text()))
        path = HOME / destination
        current = json.loads(path.read_text()) if path.is_file() else {}
        plan.write_json(path, merge_settings(current, wanted, roots))
    for source, destination in RENDERED.items():
        plan.write(HOME / destination, render_template((REPO / source).read_text()))

    hooks_path = subprocess.run(["git", "-C", str(REPO), "config", "core.hooksPath"], text=True, capture_output=True).stdout.strip()
    if (REPO / ".git").exists() and hooks_path != ".githooks":
        plan.note("git config core.hooksPath .githooks")
        if not plan.check:
            subprocess.run(["git", "-C", str(REPO), "config", "core.hooksPath", ".githooks"], check=True)

    if not plan.check:
        STATE_DIR.mkdir(exist_ok=True)
        temporary = state_file.with_name(".state.json.tmp")
        temporary.write_text(json.dumps({"repo": str(REPO), "generated": sorted(generated)}, indent=2) + "\n")
        temporary.replace(state_file)


def declared_upstream_skills():
    return {skill for skills in json.loads((REPO / "upstream/skills.json").read_text()).values() for skill in skills}


def ownership_problems(owned):
    declared = declared_upstream_skills()
    known = declared | {name for names in OTHER_INSTALLERS.values() for name in names}
    problems = []
    for home in WATCHED_HOMES:
        directory = HOME / home
        for path in sorted(directory.iterdir()) if directory.is_dir() else []:
            if not path.name.startswith(".") and path not in owned and path.name not in known:
                shown = f"~/{path.relative_to(HOME)}"
                fix = "delete the link" if path.is_symlink() else f"run kolin-skills import {shown}, or delete it"
                problems.append(f"not from the repo: {shown}; {fix}")
    for skill in sorted(declared):
        if not (HOME / ".agents/skills" / skill).exists():
            problems.append(f"not installed: {skill} from upstream/skills.json; run kolin-skills upstream")
    return problems + vendor_pin_problems()


@contextlib.contextmanager
def state_lock():
    STATE_DIR.mkdir(exist_ok=True)
    with open(STATE_DIR / "lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def run_apply(check, quiet, adopt=False, if_wired=False):
    owner = wired_repo()
    if if_wired and owner != str(REPO):
        return 0
    if owner and owner != str(REPO) and not adopt:
        print(f"kolin-skills: home is wired to {owner}, not this checkout ({REPO}). "
              "Run `kolin-skills apply --adopt` from this checkout to switch.", file=sys.stderr)
        return 1
    plan = Plan(check)
    with state_lock():
        apply(plan, {str(REPO), owner} - {None})
    for change in plan.changes:
        print(change)
    problems = ownership_problems(plan.owned)
    for problem in problems:
        print(problem)
    if not plan.changes and not problems and not quiet:
        print("already in sync")
    return 1 if check and (plan.changes or problems) else 0


def import_into_repo(raw):
    path = pathlib.Path(raw).expanduser().absolute()
    if path.is_symlink():
        raise SystemExit(f"{path} is a link to {os.readlink(path)}; delete it, or copy what it points to into the repo")
    is_skill = (path / "SKILL.md").is_file()
    locked = json.loads(NPX_SKILL_LOCK.read_text())["skills"] if NPX_SKILL_LOCK.is_file() else {}
    if is_skill and path.name in locked:
        manifest_file = REPO / "upstream/skills.json"
        manifest = json.loads(manifest_file.read_text())
        source = locked[path.name]["source"]
        manifest.setdefault(source, []).append(path.name)
        manifest_file.write_text(json.dumps(manifest, indent=2) + "\n")
        print(f"listed {path.name} under {source} in upstream/skills.json")
        return run_apply(check=False, quiet=False)
    if is_skill:
        destination = REPO / "skills" / path.name
        provided = vendor_skills().keys() | declared_upstream_skills()
    elif path.suffix == ".md" and path.parent.name == "agents":
        destination = REPO / "agents" / path.name
        provided = set()
    else:
        raise SystemExit(f"{path} is not a skill folder or an agent file; add it to the repo by hand")
    if destination.exists() or path.name in provided:
        raise SystemExit(f"the repo already provides {path.name}; compare the two and keep one")
    shutil.move(str(path), str(destination))
    print(f"moved {path} to {destination.relative_to(REPO)}")
    return run_apply(check=False, quiet=False)


GIT = ["git", "-C", str(REPO), "-c", "core.hooksPath=/dev/null"]


def git(*args, timeout=5):
    return subprocess.run([*GIT, *args], text=True, capture_output=True, timeout=timeout,
                          env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})


def fast_forward_to_trunk():
    fetched = git("fetch", "--quiet", "--prune", "origin", timeout=10)
    if fetched.returncode or git("rev-parse", "--verify", "--quiet", f"origin/{TRUNK}").returncode:
        return None
    dirty = bool(git("status", "--porcelain").stdout.strip())
    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    merged = git("for-each-ref", "--format=%(upstream:track)", f"refs/heads/{branch}").stdout.strip() == "[gone]"
    if not dirty and branch != TRUNK and merged and git("switch", "--quiet", TRUNK).returncode == 0:
        print(f"kolin-skills: {branch} is merged; switched to {TRUNK}")
        branch = TRUNK
    before = git("rev-parse", "HEAD").stdout.strip()
    merge_failure = None
    if not dirty and branch == TRUNK:
        merge = git("merge", "--ff-only", "--quiet", f"origin/{TRUNK}")
        if merge.returncode:
            merge_failure = (merge.stderr.strip() or merge.stdout.strip() or f"exit {merge.returncode}").splitlines()[-1]
    if git("rev-parse", "HEAD").stdout.strip() != before:
        print(f"kolin-skills pulled {git('log', '--oneline', f'{before}..HEAD').stdout.strip()}")
    behind = int(git("rev-list", "--count", f"HEAD..origin/{TRUNK}").stdout.strip())
    if not behind:
        return None
    blocker = (f"git merge --ff-only failed: {merge_failure}" if merge_failure
               else "it has local edits" if dirty else f"it is on {branch}, not {TRUNK}" if branch != TRUNK else "it has commits origin lacks")
    return (f"stale setup: {REPO} is {behind} commits behind origin/{TRUNK} and was not updated, because {blocker}. "
            f"Commit or discard the edits and switch to {TRUNK}, then run kolin-skills pull")


def pull(quiet):
    chatter = sys.stderr if quiet else sys.stdout
    with contextlib.redirect_stdout(chatter):
        try:
            with state_lock():
                problem = fast_forward_to_trunk()
        except subprocess.TimeoutExpired as timed_out:
            problem = f"{' '.join(timed_out.cmd[len(GIT):])} timed out after {timed_out.timeout}s; {TRUNK} was not updated"
        message = f"kolin-skills: {problem}" if problem else None
        if message:
            print(message)
        status = run_apply(check=False, quiet=quiet)
    if message and quiet:
        print(json.dumps({"systemMessage": message,
                          "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": message}}))
    return status


def vendor_git(path, *args):
    return subprocess.run(["git", "-C", str(path), *args], text=True, capture_output=True, check=True).stdout.strip()


def sync_vendor(name, source, bump):
    path = VENDOR / name
    if not (path / ".git").is_dir():
        VENDOR.mkdir(parents=True, exist_ok=True)
        clone = ["git", "clone", "--quiet", "--no-checkout", source["url"], str(path)]
        if source.get("sparse"):
            clone[3:3] = ["--filter=blob:none", "--sparse"]
        subprocess.run(clone, check=True)
    if source.get("sparse"):
        vendor_git(path, "sparse-checkout", "set", *source["sparse"])
    vendor_git(path, "fetch", "--quiet", "origin")
    pinned = source.get("rev") or vendor_git(path, "rev-parse", "origin/HEAD")
    target = vendor_git(path, "rev-parse", "origin/HEAD") if bump else pinned
    if target != pinned:
        print(f"{name} pin moves {pinned[:12]}..{target[:12]}. Review before trusting it:")
        print(vendor_git(path, "log", "--oneline", f"{pinned}..{target}"))
        print(vendor_git(path, "diff", "--stat", pinned, target))
    vendor_git(path, "checkout", "--quiet", "--detach", target)
    print(f"{name} at {target[:12]}")
    return target


def vendor_pin_problems():
    problems = []
    for name, source in json.loads((REPO / "upstream/vendor.json").read_text()).items():
        path = VENDOR / name
        if not re.fullmatch(r"[0-9a-f]{40}", source.get("rev", "")):
            problems.append(f"no full pinned rev for {name} in upstream/vendor.json; run kolin-skills upstream --bump")
        elif (path / ".git").is_dir() and vendor_git(path, "rev-parse", "HEAD") != source["rev"]:
            problems.append(f"{name} is not at its pinned rev {source['rev'][:12]}; run kolin-skills upstream")
    return problems


MIN_NODE = (22, 20)


def node_problem():
    node = shutil.which("node")
    if node is None:
        return f"Node is missing from PATH; third-party skills need Node >= {MIN_NODE[0]}.{MIN_NODE[1]}"
    try:
        raw = subprocess.run([node, "--version"], text=True, capture_output=True, timeout=10).stdout.strip()
        version = tuple(int(part) for part in raw.lstrip("v").split(".")[:2])
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return f"could not read the Node version; third-party skills need Node >= {MIN_NODE[0]}.{MIN_NODE[1]}"
    if version < MIN_NODE:
        return f"Node {raw} is too old; third-party skills need Node >= {MIN_NODE[0]}.{MIN_NODE[1]}. Upgrade Node, then run kolin-skills upstream"
    return None


def upstream(bump=False):
    manifest_file = REPO / "upstream/vendor.json"
    manifest = json.loads(manifest_file.read_text())
    failed = []
    for name, source in manifest.items():
        try:
            source["rev"] = sync_vendor(name, source, bump)
        except subprocess.CalledProcessError as error:
            failed.append(name)
            print(f"kolin-skills: could not fetch {name} ({error.stderr or 'git clone failed'}); continuing", file=sys.stderr)
    manifest_file.write_text(json.dumps(manifest, indent=2) + "\n")
    installed = {path.name for path in (HOME / ".agents/skills").iterdir()} if (HOME / ".agents/skills").is_dir() else set()
    problem = node_problem()
    if problem:
        print(f"kolin-skills: skipped third-party skills: {problem}", file=sys.stderr)
    for package, skills in ({} if problem else json.loads((REPO / "upstream/skills.json").read_text())).items():
        missing = [skill for skill in skills if skill not in installed]
        if missing:
            result = subprocess.run(["npx", "--yes", "skills", "add", package, "--global", "--yes",
                                     "--agent", "claude-code", "--agent", "codex", "--agent", "cursor",
                                     *[flag for skill in missing for flag in ("--skill", skill)]])
            if result.returncode:
                print(f"kolin-skills: npx skills add {package} failed (exit {result.returncode}); continuing", file=sys.stderr)
    return run_apply(check=False, quiet=False) or (1 if failed else 0)


def spend_failures():
    settings = json.loads((REPO / "claude/settings.json").read_text())
    failures = []
    if settings.get("env", {}).get("CLAUDE_CODE_SUBAGENT_MODEL") != SPEND_CAPS["subagent_model"]:
        failures.append(f"claude settings env.CLAUDE_CODE_SUBAGENT_MODEL must be {SPEND_CAPS['subagent_model']} so subagents without a model skip Opus")
    window = settings.get("autoCompactWindow")
    if not isinstance(window, int) or window > SPEND_CAPS["max_compact_window"]:
        failures.append(f"claude settings autoCompactWindow must be at most {SPEND_CAPS['max_compact_window']}")
    if "agent-default-model.py" not in json.dumps(settings.get("hooks", {}).get("PreToolUse", [])):
        failures.append("claude settings PreToolUse must run hooks/agent-default-model.py so Explore skips Opus")
    return failures


def without_git_repo_env():
    local = git("rev-parse", "--local-env-vars").stdout.split()
    return {key: value for key, value in os.environ.items() if key not in local}


def running_in_ci():
    return os.environ.get("CI", "").lower() in CI_VALUES


def line_count(path):
    data = path.read_bytes()
    if not data or b"\0" in data:
        return 0
    return data.count(b"\n") + (0 if data.endswith(b"\n") else 1)


def overlong_files(root=REPO, limit=MAX_FILE_LINES):
    listed = subprocess.run(["git", "-C", str(root), "ls-files", "-z"], capture_output=True)
    if listed.returncode:
        return []
    found = []
    for raw in listed.stdout.split(b"\0"):
        if not raw:
            continue
        name = os.fsdecode(raw)
        path = root / name
        if path.is_file():
            lines = line_count(path)
            if lines > limit:
                found.append(f"{name}: {lines} lines")
    return found


def check(files_only=False):
    failures = [f"{entry}, over the {MAX_FILE_LINES}-line limit; split it in its own change"
                for entry in overlong_files()]
    if files_only:
        for failure in failures:
            print(f"FAIL: {failure}", file=sys.stderr)
        return 1 if failures else 0
    test_env = without_git_repo_env()
    if running_in_ci():
        print("CI: skipped home drift and vendored skills.")
    else:
        owner = wired_repo()
        if owner not in (None, str(REPO)):
            print(f"Home is wired to {owner}, so home drift was not checked; this run checks the repo only.")
        elif run_apply(check=True, quiet=True):
            failures.append("home differs from the repo; fix each line above")
        if not vendor_skills():
            failures.append(f"no vendored skills under {VENDOR}; run kolin-skills upstream")
    failures += spend_failures()
    for relative, budget in SIZE_BUDGETS.items():
        size = (REPO / relative).stat().st_size
        if size > budget:
            failures.append(f"{relative} is {size} bytes, over its {budget}-byte budget")
    skills = sorted(path.parent.name for path in (REPO / "skills").glob("*/SKILL.md"))
    for index in SKILL_INDEXES:
        text = (REPO / index).read_text()
        missing = [name for name in skills if f"`{name}`" not in text and f"{name}/" not in text]
        if missing:
            failures.append(f"{index} does not list {', '.join(missing)}; add each to its skill index")
    for tool, purpose in REQUIRED_TOOLS.items():
        if shutil.which(tool) is None:
            failures.append(f"{tool} is missing from PATH; {purpose}")
    try:
        tests = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", str(REPO / "tests")],
                               cwd=REPO, env=test_env, text=True, capture_output=True, timeout=300)
        summary = tests.stderr.strip().splitlines()
        if summary:
            print(summary[-1])
        if tests.returncode:
            print(tests.stderr, file=sys.stderr)
            failures.append("tests failed")
    except subprocess.TimeoutExpired:
        failures.append("python tests timed out after 300s; run python3 -m unittest discover -s tests to find the hang")
    try:
        template_tests = subprocess.CompletedProcess([], 0) if shutil.which("node") is None else subprocess.run(["node", "--test", "skills/loop-refactor-to-pstack/assets/**/*.test.mjs"],
                                        cwd=REPO, env=test_env, text=True, capture_output=True, timeout=300)
        if template_tests.returncode:
            print(template_tests.stdout, file=sys.stderr)
            failures.append("loop-refactor-to-pstack gate template tests failed")
    except subprocess.TimeoutExpired:
        failures.append("loop-refactor-to-pstack gate template tests timed out after 300s; run node --test on skills/loop-refactor-to-pstack/assets to find the hang")
    try:
        budget = subprocess.run([sys.executable, str(REPO / "bin/feature-budget"), str(REPO)],
                                cwd=REPO, env=test_env, text=True, capture_output=True, timeout=60)
        sys.stdout.write(budget.stdout)
        sys.stderr.write(budget.stderr)
    except subprocess.TimeoutExpired:
        print("feature-budget timed out (report-only)")
    for failure in failures:
        print(f"FAIL: {failure}", file=sys.stderr)
    if failures:
        return 1
    print("Passed: home drift and strays (unless skipped above), spend caps, size budgets, 1,000-line files, skill indexes, required tools, vendored and third-party skills, Python and Node tests, feature-budget (report-only).")
    print("Live agent routing and model-role readiness are not checked.")
    return 0


STACKS_DIR = HOME / ".supabase/stacks"
FRESH_TRANSCRIPT_HOURS = 2


STOP_WAIT_SECONDS = 15


def process_commands(*selector):
    return subprocess.run(["ps", *(selector or ["-axww"]), "-o", "command="], capture_output=True, text=True).stdout


def postgres_running(directory):
    return f".postgres-wrapped -D {directory}/" in process_commands()


def running_stacks():
    commands = process_commands()
    stacks = []
    for directory in sorted(STACKS_DIR.iterdir()) if STACKS_DIR.is_dir() else []:
        if f".postgres-wrapped -D {directory}/data" not in commands:
            continue
        state = json.loads((directory / "state.json").read_text())
        if state.get("runtime") != "native":
            continue
        started = json.loads((directory / "owner.json").read_text())["startedAt"]
        stacks.append({"id": directory.name, "pid": json.loads((directory / "owner.json").read_text())["pid"], "root": state["identity"]["projectRoot"], "started": datetime.datetime.fromisoformat(started.replace("Z", "+00:00"))})
    return stacks


def hours_since_transcript(root):
    name = re.sub(r"[^A-Za-z0-9]", "-", root)
    config_dirs = {pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude")), HOME / ".claude", HOME / ".claude_personal"}
    writes = [path.stat().st_mtime for config in config_dirs for path in (config / "projects" / name).rglob("*") if path.is_file()]
    return (datetime.datetime.now().timestamp() - max(writes)) / 3600 if writes else None


def is_idle(stack, idle_hours):
    started_hours = (datetime.datetime.now(datetime.timezone.utc) - stack["started"]).total_seconds() / 3600
    quiet = stack["transcript_hours"] is None or stack["transcript_hours"] > FRESH_TRANSCRIPT_HOURS
    return started_hours > idle_hours and quiet


def signal_owner(stack):
    if "supabase" not in process_commands("-p", str(stack["pid"])):
        return False
    os.kill(stack["pid"], signal.SIGTERM)
    return True


def stop_stacks(targets):
    signalled = [stack for stack in targets if signal_owner(stack)]
    deadline = time.monotonic() + STOP_WAIT_SECONDS
    while time.monotonic() < deadline and any(postgres_running(STACKS_DIR / stack["id"]) for stack in signalled):
        time.sleep(0.5)
    for stack in targets:
        if stack not in signalled:
            print(f"  {stack['root']}: owner pid {stack['pid']} is not a supabase process")
        else:
            print(f"  {stack['root']}: {'still running' if postgres_running(STACKS_DIR / stack['id']) else 'stopped'}")
    return all(stack in signalled and not postgres_running(STACKS_DIR / stack["id"]) for stack in targets)


def busy_roots(roots):
    listing = subprocess.run(["lsof", "-a", "-d", "cwd", "-F", "cn"], capture_output=True, text=True).stdout
    busy, command = set(), ""
    for line in listing.splitlines():
        if line.startswith("c"):
            command = line[1:]
        elif line.startswith("n") and not command.startswith(("supabase", "postgres", ".postgres")):
            busy.update(root for root in roots if line[1:] == root or line[1:].startswith(root + "/"))
    return busy


def stacks(stop, idle_hours, notice):
    found = running_stacks()
    for stack in found:
        stack["transcript_hours"] = hours_since_transcript(stack["root"])
        stack["idle"] = is_idle(stack, idle_hours)
    idle = [stack for stack in found if stack["idle"]]
    if notice:
        if idle:
            message = f"{len(idle)} idle local Supabase stacks hold shared-memory segments (macOS allows 32). Run: kolin-skills stacks --stop"
            print(json.dumps({"systemMessage": message}))
        return 0
    busy = busy_roots({stack["root"] for stack in idle}) if stop and idle else set()
    for stack in found:
        transcript = "none" if stack["transcript_hours"] is None else f"{stack['transcript_hours']:.1f}h ago"
        print(f"{'idle' if stack['idle'] else 'keep'}  {stack['root']}  started {stack['started'].astimezone():%Y-%m-%d %H:%M}  transcript {transcript}")
    print(f"{len(found)} running, {len(idle)} idle")
    if not stop:
        return 0
    for stack in idle:
        if stack["root"] in busy:
            print(f"  skipped: a process works in {stack['root']}")
    return 0 if stop_stacks([stack for stack in idle if stack["root"] not in busy]) else 1


def main():
    parser = argparse.ArgumentParser(prog="kolin-skills", description="Make every agent harness on this machine match the Kolin-Skills repo.")
    commands = parser.add_subparsers(dest="command", required=True)
    apply_parser = commands.add_parser("apply", help="link and render the repo into home; idempotent and offline")
    apply_parser.add_argument("--check", action="store_true", help="report drift and change nothing")
    apply_parser.add_argument("--quiet", action="store_true", help="print only changes")
    apply_parser.add_argument("--adopt", action="store_true", help="wire home to this checkout when another one owns it")
    apply_parser.add_argument("--if-wired", action="store_true", help="do nothing unless home is wired to this checkout")
    pull_parser = commands.add_parser("pull", help="fast-forward the repo from its remote, then apply")
    pull_parser.add_argument("--quiet", action="store_true", help="print only changes")
    import_parser = commands.add_parser("import", help="move a skill or agent made in home into the repo, or list an npx skill in upstream/skills.json, then apply")
    import_parser.add_argument("path")
    upstream_parser = commands.add_parser("upstream", help="check out vendored pstack and cursor-team-kit at their pins, add missing third-party skills, then apply")
    upstream_parser.add_argument("--bump", action="store_true", help="move each vendor pin to its newest upstream commit and print what changed")
    stacks_parser = commands.add_parser("stacks", help="list running native Supabase stacks; --stop stops the idle ones")
    stacks_parser.add_argument("--stop", action="store_true", help="send SIGTERM to each idle stack's supabase owner process and wait for postgres to exit; skips a root another process works in")
    stacks_parser.add_argument("--idle-hours", type=float, default=6, help="a stack is idle only after it has run this many hours; the 2-hour transcript window stays fixed")
    stacks_parser.add_argument("--notice", action="store_true", help="session-start hook: one JSON line when idle stacks exist, else nothing")
    check_parser = commands.add_parser("check", help="the gate: drift, strays, missing skills, spend caps, budgets, file length and tests")
    check_parser.add_argument("--files", action="store_true", help="only the 1,000-line file limit")
    commands.add_parser("install", help="first run on a machine: upstream, apply, check")
    args = parser.parse_args()
    if args.command == "apply":
        return run_apply(args.check, args.quiet, args.adopt, args.if_wired)
    if args.command == "pull":
        return pull(args.quiet)
    if args.command == "import":
        return import_into_repo(args.path)
    if args.command == "upstream":
        return upstream(args.bump)
    if args.command == "stacks":
        return stacks(args.stop, args.idle_hours, args.notice)
    if args.command == "check":
        return check(files_only=args.files)
    fetched = upstream()
    return check() or fetched


if __name__ == "__main__":
    sys.exit(main())
