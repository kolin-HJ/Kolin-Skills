#!/usr/bin/env python3
import argparse
import collections
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys
import time

HOME = pathlib.Path.home()
STATE = HOME / ".kolin-skills"
REPORT = STATE / "context-audit.json"
CACHE = STATE / "context-audit-cache.json"
STAMP = STATE / "context-audit.started"
LOG = STATE / "context-audit.log"
WINDOW_DAYS = 30
REFRESH_DAYS = 7
MIN_ITEM_TOKENS = 100
MIN_NOTICE_TOKENS = 500
SESSION_DAYS = 14
LONG_RUN_CALLS = 200
HOOK_BLOCK = re.compile(r"hook error: \[[^\]]*?([^/\s']+?)'?\]: (.{0,50})", re.S)
SKILL_PATH = re.compile(r"skills/([A-Za-z0-9:_-]+)/SKILL\.md")
COMMAND = re.compile(r"<command-name>/?([^<]+)</command-name>")
LISTED_SKILL = re.compile(r"^- ([A-Za-z0-9:_-]+)(?::|$)", re.M)
DEFERRED_LIST = re.compile(r"[^\n]*deferred tools are now available[^\n]*\n((?:[^\n]+\n)+)")
DEFERRED_NAME = re.compile(r"^(mcp__[A-Za-z0-9_-]+__[^\s]+)$", re.M)
KEPT = {
    "tool:ReportFindings", "skill:update-config", "skill:run",
    "skill:anthropic-skills:built-in-browser", "skill:anthropic-skills:chrome-browser",
}


def config_dirs():
    dirs = [pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude")), HOME / ".claude"]
    unique = {}
    for path in dirs:
        unique.setdefault(path.resolve(), path)
    return [path / "projects" for path in unique.values() if (path / "projects").is_dir()]


def records(path):
    with open(path, errors="ignore") as handle:
        for line in handle:
            if line.strip():
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue


def write_json(path, data):
    STATE.mkdir(exist_ok=True)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(data))
    os.replace(temporary, path)


def section(text, start, ends):
    begin = text.find(start)
    if begin < 0:
        return ""
    stops = [stop for stop in (text.find(end, begin + len(start)) for end in ends) if stop >= 0]
    return text[begin:min(stops, default=len(text))]


def read_requests(path):
    shape, texts, first = None, [], None
    for record in records(path):
        kind = record.get("type")
        if kind == "api-request-shape" and shape is None:
            shape = record["shape"]
        elif kind == "api-request-blob":
            texts += [block.get("text", "") for block in record["message"]["content"] if isinstance(block, dict)]
        elif kind == "assistant" and shape is not None and first is None:
            usage = record["message"]["usage"]
            first = ("\n".join(texts), usage.get("input_tokens", 0) + usage.get("cache_creation_input_tokens", 0) + usage.get("cache_read_input_tokens", 0))
    return (shape, first, "\n".join(texts)) if first else None


def measure_costs(shape, first, text):
    chars = {}
    for tool in shape["tools"]:
        chars[("tool", tool["name"])] = len(json.dumps(tool))
    listing = section(text, "The following skills are available", ["\n\n\n", "</system-reminder>"])
    for line in listing.splitlines():
        match = LISTED_SKILL.match(line)
        if match:
            chars[("skill", match.group(1))] = len(line)
    for name in {name for block in DEFERRED_LIST.findall(text) for name in DEFERRED_NAME.findall(block)}:
        server = ("mcp", name.split("__")[1])
        chars[server] = chars.get(server, 0) + len(name) + 1
    servers = {name for kind, name in chars if kind == "mcp"}
    owner = None
    for block in re.split(r"\n(?=## )", section(text, "# MCP Server Instructions", ["The following skills are available", "<system-reminder>"]))[1:]:
        heading = re.sub(r"[ .]", "_", block[3:block.find("\n")].strip())
        owner = heading if heading in servers else owner
        if owner:
            chars[("mcp", owner)] += len(block)
    first_text, first_tokens = first
    whole = sum(len(block["text"]) for block in shape["system"]) + sum(len(json.dumps(tool)) for tool in shape["tools"]) + len(first_text)
    ratio = whole / first_tokens
    return {key: round(value / ratio) for key, value in chars.items()}


def latest_costs():
    transcripts = sorted((path for root in config_dirs() for path in root.glob("*/*.jsonl")), key=lambda path: path.stat().st_mtime, reverse=True)
    for path in transcripts[:50]:
        request = read_requests(path)
        if request and any(tool["name"] == "Skill" for tool in request[0]["tools"]):
            return path, request[1][1], measure_costs(*request)
    sys.exit("context-audit: none of the 50 newest transcripts holds an api-request-shape record with the Skill tool")


def file_uses(path):
    uses = collections.Counter()
    for record in records(path):
        message = record.get("message")
        if not isinstance(message, dict) or not isinstance(message.get("content"), (list, str)):
            continue
        if record.get("type") == "user":
            for name in COMMAND.findall(json.dumps(message["content"])):
                uses[f"skill:{name.strip()}"] += 1
            continue
        if record.get("type") != "assistant" or isinstance(message["content"], str):
            continue
        for block in message["content"]:
            if block.get("type") != "tool_use":
                continue
            name, arguments = block["name"], block.get("input") or {}
            uses[f"tool:{name}"] += 1
            if name.startswith("mcp__"):
                uses[f"mcp:{name.split('__')[1]}"] += 1
            if name == "Skill":
                uses[f"skill:{arguments.get('skill', '')}"] += 1
            if name in ("Read", "Bash"):
                for skill in set(SKILL_PATH.findall(json.dumps(arguments))):
                    uses[f"skill:{skill}"] += 1
    return uses


def window_uses():
    cutoff = time.time() - WINDOW_DAYS * 86400
    cache = json.loads(CACHE.read_text()) if CACHE.is_file() else {}
    fresh, total, sessions = {}, collections.Counter(), 0
    for root in config_dirs():
        for path in root.rglob("*.jsonl"):
            stat = path.stat()
            if stat.st_mtime < cutoff:
                continue
            key = str(path)
            entry = cache.get(key)
            if not entry or entry["mtime"] != stat.st_mtime or entry["size"] != stat.st_size:
                entry = {"mtime": stat.st_mtime, "size": stat.st_size, "uses": file_uses(path)}
            fresh[key] = entry
            total.update(entry["uses"])
            sessions += path.parent.parent == root
    write_json(CACHE, fresh)
    return total, sessions


def refresh():
    source, start_tokens, costs = latest_costs()
    uses, sessions = window_uses()
    waste = sorted(([kind, name, tokens] for (kind, name), tokens in costs.items()
                    if tokens >= MIN_ITEM_TOKENS and uses[f"{kind}:{name}"] == 0 and f"{kind}:{name}" not in KEPT), key=lambda item: -item[2])
    report = {"generated": datetime.date.today().isoformat(), "source": str(source), "start_tokens": start_tokens,
              "sessions": sessions, "waste": waste, "waste_tokens": sum(item[2] for item in waste)}
    write_json(REPORT, report)
    return report


def print_report(report):
    print(f"Context audit {report['generated']}: {report['sessions']} sessions, headless runs included, in {WINDOW_DAYS} days. "
          f"Costs measured from {report['source']} ({report['start_tokens']:,} tokens at start).")
    if not report["waste"]:
        print(f"Nothing over {MIN_ITEM_TOKENS} tokens went unused.")
        return
    print(f"Unused for {WINDOW_DAYS} days, {report['waste_tokens']:,} tokens in every session:")
    for kind, name, tokens in report["waste"]:
        print(f"  {kind:<6} {name:<48} {tokens:>6,}")
    print('Fix: skill -> claude/settings.json skillOverrides "<name>": "user-invocable-only" (plugin skill -> enabledPlugins). '
          "tool or mcp -> permissions.deny in ~/.claude/settings.json, or disconnect the connector.")


def notice():
    report = json.loads(REPORT.read_text()) if REPORT.is_file() else None
    week_ago = datetime.date.today() - datetime.timedelta(days=REFRESH_DAYS)
    stale = report is None or datetime.date.fromisoformat(report["generated"]) < week_ago
    started_today = STAMP.is_file() and STAMP.stat().st_mtime > time.time() - 86400
    message = None
    if stale and LOG.is_file() and LOG.stat().st_size:
        message = f"context-audit refresh failed; see {LOG}"
    if stale and not started_today:
        STATE.mkdir(exist_ok=True)
        STAMP.touch()
        with open(LOG, "w") as log:
            subprocess.Popen([sys.executable, __file__, "--refresh"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=log, start_new_session=True)
    if report and report["waste_tokens"] >= MIN_NOTICE_TOKENS:
        message = (f"Context audit {report['generated']}: {len(report['waste'])} unused items cost {report['waste_tokens']:,} "
                   "tokens per session. Run context-audit for the list.")
    if message:
        print(json.dumps({"systemMessage": message}))


def result_text(content):
    if isinstance(content, str):
        return content
    return "\n".join(block.get("text", "") for block in content if isinstance(block, dict))


def session_stats(path):
    messages, calls, outcomes = {}, {}, {}
    hooks, urls, compactions, first = collections.Counter(), set(), 0, None
    for record in records(path):
        kind = record.get("type")
        first = first or record.get("timestamp")
        if kind == "pr-link":
            urls.add(record["prUrl"])
        elif kind == "system" and record.get("subtype") == "compact_boundary":
            compactions += 1
        elif kind == "assistant":
            message = record["message"]
            usage = message.get("usage") or {}
            context = usage.get("input_tokens", 0) + usage.get("cache_creation_input_tokens", 0) + usage.get("cache_read_input_tokens", 0)
            messages[message.get("id") or record.get("uuid")] = (message.get("model"), context, usage.get("output_tokens", 0))
            for block in message["content"] if isinstance(message.get("content"), list) else []:
                if block.get("type") == "tool_use":
                    calls[block["id"]] = block["name"]
        elif kind == "user" and isinstance(record["message"].get("content"), list):
            for block in record["message"]["content"]:
                if block.get("type") != "tool_result":
                    continue
                failed = bool(block.get("is_error"))
                outcomes[block["tool_use_id"]] = failed
                blocked = HOOK_BLOCK.search(result_text(block.get("content", ""))) if failed else None
                if blocked:
                    hooks[(blocked.group(1), " ".join(blocked.group(2).split()))] += 1
    models = collections.Counter(model for model, _, _ in messages.values())
    return {
        "model": models.most_common(1)[0][0] if models else "unknown",
        "tokens": sum(context + output for _, context, output in messages.values()),
        "peak": max((context for _, context, _ in messages.values()), default=0),
        "calls": len(calls), "compactions": compactions, "hooks": hooks, "urls": urls, "first": first,
        "tools": [(name, outcomes.get(tool_id) is False) for tool_id, name in calls.items()],
    }


def session_files(days):
    cutoff = time.time() - days * 86400
    root = config_dirs()[0]
    for pattern, is_agent in (("*/*.jsonl", False), ("*/*/subagents/agent-*.jsonl", True)):
        for path in root.glob(pattern):
            if path.stat().st_mtime >= cutoff:
                yield path, is_agent


def agent_type(path):
    meta = path.with_suffix(".meta.json")
    return json.loads(meta.read_text()).get("agentType", "unknown") if meta.is_file() else "unknown"


def median(values):
    ordered = sorted(values)
    middle = len(ordered) // 2
    return ordered[middle] if len(ordered) % 2 else (ordered[middle - 1] + ordered[middle]) / 2


def print_sessions(days):
    runs, tools = collections.defaultdict(list), collections.defaultdict(lambda: [0, 0])
    hooks, urls, split = collections.Counter(), set(), collections.Counter()
    sessions = collections.defaultdict(lambda: {"tokens": 0, "compactions": 0, "date": "", "subagents": 0})
    for path, is_agent in session_files(days):
        stats = session_stats(path)
        owner = (path.parent.parent.parent.name, path.parent.parent.name) if is_agent else (path.parent.name, path.stem)
        side = "subagent" if is_agent else "main"
        runs[(agent_type(path) if is_agent else "main", stats["model"])].append(stats)
        split[side] += stats["tokens"]
        split[side + " runs"] += 1
        urls |= stats["urls"]
        for name, succeeded in stats["tools"]:
            tools[name][0] += 1
            tools[name][1] += succeeded
        for (hook, text), count in stats["hooks"].items():
            hooks[(side, hook, text)] += count
        entry = sessions[owner]
        entry["tokens"] += stats["tokens"]
        if is_agent:
            entry["subagents"] += 1
        else:
            entry["compactions"] = stats["compactions"]
            entry["date"] = (stats["first"] or "")[:10]
    print(f"Sessions audit, last {days} days: {split['main runs']} main sessions, {split['subagent runs']} subagents, "
          f"{split['main'] + split['subagent']:,} tokens (main {split['main']:,}, subagents {split['subagent']:,}).")
    print(f"\nBy agent and model: runs, tokens, median calls, runs over {LONG_RUN_CALLS} calls, peak context median and max")
    for (label, model), group in sorted(runs.items(), key=lambda item: -sum(run["tokens"] for run in item[1])):
        peaks = [run["peak"] for run in group]
        print(f"  {label:<24} {model:<28} {len(group):>5} {sum(run['tokens'] for run in group):>15,} {median([run['calls'] for run in group]):>7g} "
              f"{sum(run['calls'] > LONG_RUN_CALLS for run in group):>4} {median(peaks):>11,g} {max(peaks):>11,}")
    print("\nCostliest sessions, subagents included: project, date, tokens, subagents, compactions")
    for (project, _), entry in sorted(sessions.items(), key=lambda item: -item[1]["tokens"])[:5]:
        print(f"  {project[-40:]:<40} {entry['date'] or '-':<10} {entry['tokens']:>15,} {entry['subagents']:>4} {entry['compactions']:>3}")
    print("\nHook blocks, top 10")
    for (side, hook, text), count in hooks.most_common(10):
        print(f"  {count:>5}  {side:<8} {hook}: {text}")
    print("\nTools that always fail, 3+ calls and 0 successes")
    for name, (calls, successes) in sorted(tools.items()):
        if calls >= 3 and successes == 0:
            print(f"  {name}: {calls}")
    print(f"\nUnique PR URLs linked: {len(urls)}")


def main():
    parser = argparse.ArgumentParser(prog="context-audit", description="List skills, tools and MCP servers that cost context in every session and went unused for 30 days.")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--notice", action="store_true", help="session-start hook: one line when waste exists; refresh in the background when the report is a week old")
    mode.add_argument("--refresh", action="store_true", help="rebuild the report and print nothing")
    mode.add_argument("--sessions", action="store_true", help="report token use, hook blocks and failing tools across recent session transcripts")
    parser.add_argument("--days", type=int, default=SESSION_DAYS, help="window for --sessions")
    args = parser.parse_args()
    if args.sessions:
        return print_sessions(args.days)
    if args.notice:
        return notice()
    report = refresh()
    if not args.refresh:
        print_report(report)


if __name__ == "__main__":
    sys.exit(main())
