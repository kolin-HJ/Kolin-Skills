#!/usr/bin/env python3
import argparse
import importlib.machinery
import importlib.util
import os
import pathlib
import sys

GITHUB_BODY_LIMIT = 65_536
FILLED_TEXT_RESERVE = 8_000
GROUPS = ("Code", "Tests", "Docs")

SECTIONS = (
    ("Summary", "<What ships, for whom, and what changes for them, in two to four sentences. "
                "A release lists each merged PR in one line; PRs that cancel each other share one line.>"),
    ("Review this", "- [ ] <file:line: the decision or risky hunk to double check, and why>"),
    ("Blast Radius", "<What this touches outside the diff (policy, Before a PR ships), or \"None.\">"),
    ("Verification", "- Ran: `<command>` <result>\n- Not run: <check>, because <why>"),
)
SKELETON = "Value: <kind> — <one sentence>\n\n" + "".join(
    f"## {title}\n\n{placeholder}\n\n" for title, placeholder in SECTIONS) + "## Diff\n"


def load_audit():
    path = str(pathlib.Path(__file__).with_name("diff-audit"))
    loader = importlib.machinery.SourceFileLoader("diff_audit", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("diff_audit", loader))
    loader.exec_module(module)
    return module


def group_of(path, audit):
    if audit.TEST.search(path):
        return "Tests"
    if audit.DOC.search(path):
        return "Docs"
    return "Code"


def files_label(n):
    return f"{n} file{'' if n == 1 else 's'}"


def changes(base, audit):
    files = []
    for record in audit.git("diff", "--numstat", "-z", "--no-renames", base, "HEAD").split("\0"):
        if not record:
            continue
        added, removed, path = record.split("\t", 2)
        binary, lock = added == "-", bool(audit.LOCK.search(path))
        lines = "binary" if binary else f"+{added} -{removed}" + (", lockfile" if lock else "")
        files.append({"added": 0 if binary else int(added), "removed": 0 if binary else int(removed),
                      "group": group_of(path, audit), "lock": lock, "line": f"- `{path}` {lines}"})
    return files


def count(files):
    counted = [f for f in files if not f["lock"]]
    return f"+{sum(f['added'] for f in counted)} -{sum(f['removed'] for f in counted)}"


def fold(group, members, shown):
    lines = [f["line"] for f in shown]
    if len(members) > len(shown):
        lines.append(f"- Not shown: {files_label(len(members) - len(shown))}, see Files changed")
    summary = f"{group}: {files_label(len(members))}, {count(members)}"
    return f"<details>\n<summary>{summary}</summary>\n\n" + "\n".join(lines) + "\n\n</details>\n\n"


def render(files):
    groups = {group: [f for f in files if f["group"] == group] for group in GROUPS}
    rows = ["| Group | Files | Lines |", "|---|---|---|"] + [
        f"| {group} | {len(members)} | {count(members)} |" for group, members in groups.items()]
    head = SKELETON + "\n" + "\n".join(rows) + "\n\n"
    budget = GITHUB_BODY_LIMIT - FILLED_TEXT_RESERVE - len(head)
    shown = {group: list(members) for group, members in groups.items() if members}

    def body():
        return "".join(fold(group, groups[group], shown[group]) for group in shown)

    while len(body()) > budget:
        shown[max(shown, key=lambda group: len(shown[group]))].pop()
    return head + body()


def main():
    parser = argparse.ArgumentParser(description="Print the PR body skeleton with each changed file's line counts grouped into code, tests and docs.")
    parser.add_argument("base", nargs="?", default="origin/HEAD")
    args = parser.parse_args()
    audit = load_audit()
    os.chdir(audit.git("rev-parse", "--show-toplevel").strip())
    base = audit.git("merge-base", args.base, "HEAD").strip()
    sys.stdout.write(render(changes(base, audit)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
