#!/usr/bin/env python3
import argparse
import json
import os
import re
import subprocess
import sys

CODE = re.compile(r"\.(ts|tsx|js|jsx|mjs|cjs|py|go|rs|java|kt|rb|swift|sh)$")
HASH_COMMENT = re.compile(r"\.(py|rb|sh)$")
TEST = re.compile(r"(\.test\.|\.spec\.|(^|/)tests?/|_test\.(py|go)$|(^|/)test_[^/]+\.py$)")
LOCK = re.compile(r"(lock\.json|\.lock|lock\.yaml)$")
DOC = re.compile(r"\.(md|mdx|txt|rst)$")
SKIP = re.compile(r"\b(it|test|describe)\.(skip|only|todo)\b|\b[xf](it|describe|test)\(|@pytest\.mark\.(skip|xfail)"
                  r"|\bpytest\.skip\(|\bt\.Skip\(|@Disabled|@Ignore")
TEST_DEF = re.compile(r"^\s*(it|test|describe)(\.\w+)?\(|^\s*(async\s+)?def test_|^\s*func Test")
DOC_READ = re.compile(r"""(read_text|readFile\w*|open)\(?[^\n]*['"][\w./-]+\.mdx?['"]|['"][\w./-]+\.mdx?['"]\)?\.(read_text|read)\(""")
ASSERTION = re.compile(r"\bexpect\(|\bassert")
WEAK = re.compile(r"\.(toBeTruthy|toBeDefined|toBeFalsy)\(\)|\.not\.toThrow\(\)|\.toHaveBeenCalled\(\)"
                  r"|\.toBeInstanceOf\(|^\s*assert\s+[\w.]+\s*$|assertTrue\(|assert_called\(\)")
HATCH = re.compile(r"\bas any\b|:\s*any\b|<any>|\bany\[\]|@ts-ignore|@ts-nocheck|#\s*type:\s*ignore\s*$")
DIRECTIVE = re.compile(r"eslint-disable|oxlint-disable|@ts-expect-error|\bnoqa\b")
SWALLOW = re.compile(r"catch\s*(\([^)]*\))?\s*\{\s*\}|\.catch\(\s*\(\s*\w*\s*\)\s*=>\s*(\{\s*\}|undefined|null)\s*\)"
                     r"|except(\s+[\w.]+(\s+as\s+\w+)?)?\s*:\s*pass\b")
DEBUG = re.compile(r"^\s*debugger\s*;?\s*$")
UI_LOG = re.compile(r"\bconsole\.(log|debug)\(")
JS = re.compile(r"\.(ts|tsx|js|jsx|mjs|cjs)$")
UI = re.compile(r"\.(tsx|jsx)$")
EXCEPT = re.compile(r"^\s*except\b.*:\s*$")
COMMENT = re.compile(r"^\s*(//|/\*|\*(\s|/|$))")
SYMBOL = re.compile(r"^(export\s+)?(default\s+)?(async\s+)?(function\*?|class|interface|type|enum|def|const|let)\s+(\w+)")
HUNK = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
DEP_KEYS = ("dependencies", "devDependencies", "peerDependencies", "optionalDependencies")


def git(*args):
    return subprocess.run(["git", *args], text=True, capture_output=True, check=True).stdout


def parse(diff):
    files, current, new_line = {}, None, 0
    for line in diff.splitlines():
        if line.startswith("diff --git"):
            current = None
        elif line.startswith("--- "):
            old = line[4:].removeprefix("a/")
        elif line.startswith("+++ "):
            new = line[4:].removeprefix("b/")
            path = old if new == "/dev/null" else new
            current = files.setdefault(path, {"added": [], "removed": [], "new": old == "/dev/null",
                                              "deleted": new == "/dev/null"})
        elif current is not None and (match := HUNK.match(line)):
            new_line = int(match.group(3))
        elif current is not None and line.startswith("+"):
            current["added"].append((new_line, line[1:]))
            new_line += 1
        elif current is not None and line.startswith("-"):
            current["removed"].append(line[1:])
    return files


def untracked(files):
    for path in git("ls-files", "--others", "--exclude-standard").splitlines():
        try:
            text = open(path, encoding="utf-8").read()
        except (UnicodeDecodeError, OSError):
            continue
        files[path] = {"added": list(enumerate(text.splitlines(), 1)), "removed": [], "new": True, "deleted": False}


def dependency_findings(path, base):
    if path.endswith("package.json"):
        def deps(text):
            data = json.loads(text) if text.strip() else {}
            return {name for key in DEP_KEYS for name in data.get(key, {})}
        try:
            before = git("show", f"{base}:{path}")
        except subprocess.CalledProcessError:
            before = ""
        try:
            return sorted(deps(open(path).read()) - deps(before))
        except (OSError, ValueError):
            return []
    return []


def audit(files, base):
    blocks, info, added_total, removed_total = [], [], 0, 0
    for path, change in sorted(files.items()):
        is_test, is_code = bool(TEST.search(path)), bool(CODE.search(path))
        if not LOCK.search(path):
            added_total += len(change["added"])
            removed_total += len(change["removed"])
        if change["new"]:
            info.append(f"new file: {path}" + ("  (doc: who reads it, and what is wrong without it?)" if DOC.search(path) else ""))
        if is_test:
            lost_tests = sum(bool(TEST_DEF.search(l)) for l in change["removed"]) - sum(bool(TEST_DEF.search(l)) for _, l in change["added"])
            lost_asserts = sum(bool(ASSERTION.search(l)) for l in change["removed"]) - sum(bool(ASSERTION.search(l)) for _, l in change["added"])
            if change["deleted"] or lost_tests > 0 or lost_asserts > 0:
                blocks.append(("test-removed", f"{path} lost {max(lost_tests, 0)} tests and {max(lost_asserts, 0)} assertions"))
        for name in dependency_findings(path, base):
            blocks.append(("dependency", f"{path} adds {name}: state why no installed package or platform API does it, and prove it exists (npm view {name})"))
        if path.endswith("requirements.txt") or path.endswith("go.mod"):
            for number, line in change["added"]:
                if line.strip() and not line.lstrip().startswith(("#", "module", "go ")):
                    blocks.append(("dependency", f"{path}:{number} {line.strip()}"))
        previous = ""
        for number, line in change["added"]:
            where = f"{path}:{number} {line.strip()[:100]}"
            if is_test and SKIP.search(line):
                blocks.append(("skip", where))
            if is_test and WEAK.search(line):
                blocks.append(("weak-assert", where))
            if is_test and DOC_READ.search(line):
                blocks.append(("doc-read", where))
            if is_test and TEST_DEF.search(line):
                info.append(f"new test: {where}  (which behavior a caller relies on fails without it?)")
            if is_code:
                directive = DIRECTIVE.search(line)
                if HATCH.search(line) or (directive and " -- " not in line):
                    blocks.append(("escape-hatch", where))
                if not is_test and ((JS.search(path) and DEBUG.match(line)) or (UI.search(path) and UI_LOG.search(line))):
                    blocks.append(("debug-leftover", where))
                if SWALLOW.search(line) or (line.strip() == "pass" and EXCEPT.match(previous)):
                    blocks.append(("swallowed-error", where))
                hash_comment = HASH_COMMENT.search(path) and line.lstrip().startswith("#") and not line.startswith("#!")
                if (COMMENT.match(line) or hash_comment) and not directive:
                    blocks.append(("comment", where))
                if not is_test and (match := SYMBOL.match(line)):
                    info.append(f"new symbol: {match.group(5)} ({path})")
            previous = line
    return blocks, info, added_total, removed_total


def main():
    parser = argparse.ArgumentParser(description="Flag reward hacks and slop in a diff, and list every addition for the value check.")
    parser.add_argument("base", nargs="?", default="origin/HEAD")
    parser.add_argument("--allow", action="append", default=[], help="a finding kind the PR body justifies")
    args = parser.parse_args()
    os.chdir(git("rev-parse", "--show-toplevel").strip())
    base = git("merge-base", args.base, "HEAD").strip()
    files = parse(git("diff", "-U0", "--no-color", "--no-renames", base))
    untracked(files)
    blocks, info, added, removed = audit(files, base)
    allowed = {kind for value in args.allow for kind in value.split(",")}
    for line in info:
        print(line)
    print(f"net lines: +{added} -{removed} in {len(files)} files" + ("  (over 600 added or 40 files: name the split)" if added > 600 or len(files) > 40 else ""))
    failing = [(kind, where) for kind, where in blocks if kind not in allowed]
    for kind, where in blocks:
        print(f"{'allowed' if kind in allowed else 'block'} {kind}: {where}")
    if failing:
        print("Fix each block, or justify it in the PR body and rerun with --allow <kind>. Then answer for each new file and symbol: what breaks if it goes?")
    return 1 if failing else 0


if __name__ == "__main__":
    sys.exit(main())
