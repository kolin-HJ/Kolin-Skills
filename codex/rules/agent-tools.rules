prefix_rule(
    pattern = ["agent-browser-guard"],
    decision = "allow",
    justification = "agent-browser needs Chrome and the window server, which the seatbelt sandbox blocks; the guard refuses program-running flags and writes outside ~/.agent-browser-evidence",
    match = [["agent-browser-guard", "open", "https://example.com"]],
    not_match = [["agent-browser", "open", "https://example.com"], ["agent-browser-guardx"]],
)

prefix_rule(
    pattern = ["agent-desktop"],
    decision = "prompt",
    justification = "agent-desktop outside the sandbox can operate any app, including a terminal, so Kolin approves each call",
    match = [["agent-desktop", "snapshot", "-i"]],
)
